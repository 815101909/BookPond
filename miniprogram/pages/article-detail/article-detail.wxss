/* 文章详情页样式 */
page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

.container {
  padding-bottom: 30rpx;
}

/* 加载状态 */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid #e5e5e5;
  border-top: 6rpx solid #009688;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 30rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #666;
}

/* 文章容器 */
.article-container {
  background-color: white;
  padding-bottom: 40rpx;
}

/* 文章头部 */
.article-header {
  padding: 40rpx 30rpx 20rpx;
}

.article-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.4;
  margin-bottom: 20rpx;
}

.article-meta {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #999;
}

.article-category {
  background-color: #e8f5e9;
  color: #009688;
  padding: 4rpx 16rpx;
  border-radius: 100rpx;
  margin-right: 15rpx;
}

.article-date {
  color: #999;
}

/* 文章封面图 */
.article-cover {
  width: 100%;
  margin-bottom: 30rpx;
}

.article-cover image {
  width: 100%;
  display: block;
}

/* 文章内容 */
.article-content {
  padding: 0 30rpx;
  font-size: 30rpx;
  line-height: 1.8;
  color: #333;
}

.article-content rich-text {
  display: block;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  justify-content: space-around;
  padding: 40rpx 60rpx 20rpx;
  border-top: 1rpx solid #eee;
  margin-top: 60rpx;
}

.action-button {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 40rpx;
  border-radius: 10rpx;
}

.action-button.active {
  background-color: rgba(255, 82, 82, 0.1);
}

.button-icon {
  font-size: 42rpx;
  margin-bottom: 10rpx;
}

.button-text {
  font-size: 24rpx;
  color: #666;
}

.action-button.active .button-text {
  color: #ff5252;
}

/* 错误信息 */
.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 30rpx;
  background: white;
  margin: 30rpx;
  border-radius: 15rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.error-icon {
  font-size: 80rpx;
  margin-bottom: 30rpx;
}

.error-message {
  font-size: 34rpx;
  font-weight: bold;
  color: #546e7a;
  margin-bottom: 20rpx;
}

.error-retry {
  margin-top: 30rpx;
  background: #009688;
  color: white;
  padding: 16rpx 60rpx;
  border-radius: 100rpx;
  font-size: 28rpx;
} 