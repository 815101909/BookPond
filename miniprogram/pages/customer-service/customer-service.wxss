/* 客服页面样式 */
page {
  background-color: #e8f5e9;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  overflow-x: hidden;
}

.container {
  padding: 30rpx;
  width: 100%;
  box-sizing: border-box;
}

/* 头部样式 */
.service-header {
  text-align: center;
  margin-bottom: 40rpx;
  padding: 20rpx 0;
  width: 100%;
  box-sizing: border-box;
}

.header-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 15rpx;
}

.header-desc {
  font-size: 28rpx;
  color: #666;
}

/* 主要内容区域 */
.main-content {
  width: 100%;
  box-sizing: border-box;
}

/* 联系方式部分 */
.contact-section {
  background: white;
  border-radius: 15rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  width: 100%;
  box-sizing: border-box;
}

.contact-list {
  width: 100%;
  box-sizing: border-box;
}

.section-title {
  font-size: 34rpx;
  font-weight: bold;
  margin-bottom: 25rpx;
  color: #333;
  border-left: 8rpx solid #009688;
  padding-left: 15rpx;
}

.contact-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  width: 100%;
  box-sizing: border-box;
}

.contact-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
  color: #009688;
  width: 60rpx;
  text-align: center;
}

.contact-info {
  flex: 1;
}

.contact-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 5rpx;
}

.contact-value {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.contact-action {
  font-size: 26rpx;
  color: #009688;
  background: #e0f2f1;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
}

/* 二维码包装器 */
.qrcode-wrapper {
  width: 100%;
  box-sizing: border-box;
}

/* 二维码部分 */
.qrcode-section {
  background: white;
  border-radius: 15rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  display: flex;
  flex-direction: column;
  width: 100%;
  box-sizing: border-box;
}

.qrcode-container {
  margin: 30rpx 0;
  width: 100%;
  display: flex;
  justify-content: center;
  box-sizing: border-box;
}

.qrcode-placeholder {
  width: 480rpx;
  height: 280rpx;
  background: #f5f5f5;
  border: 2rpx dashed #ccc;
  border-radius: 10rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  box-sizing: border-box;
}

.placeholder-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.placeholder-desc {
  font-size: 24rpx;
  color: #bbb;
}

.qrcode-tip {
  font-size: 24rpx;
  color: #888;
  text-align: center;
  margin-top: 20rpx;
}

.service-time-section {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.service-time-section .section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-left: 20rpx;
  border-left: 8rpx solid #009688;
}

.time-item {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
  line-height: 1.5;
}

.holiday-tip {
  font-size: 24rpx;
  color: #999;
  margin-top: 20rpx;
  line-height: 1.5;
}

.qrcode-image {
  width: 600rpx;
  height: 280rpx;
  border-radius: 10rpx;
}

/* 加载状态 */
.qrcode-loading {
  width: 480rpx;
  height: 280rpx;
  background: #f8f8f8;
  border-radius: 10rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.loading-icon {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e0e0e0;
  border-top: 4rpx solid #009688;
  border-radius: 50%;
  margin-bottom: 20rpx;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}