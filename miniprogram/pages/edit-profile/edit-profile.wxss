.edit-container {
  padding: 40rpx;
  background-color: #fff;
  min-height: 100vh;
  box-sizing: border-box;
}

.header {
  margin-bottom: 50rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.title {
  font-size: 36rpx;
  font-weight: 500;
  color: #333;
}

.input-section {
  margin-bottom: 60rpx;
  position: relative;
}

.input-field {
  width: 100%;
  height: 90rpx;
  border-bottom: 2rpx solid #e0e0e0;
  font-size: 32rpx;
  padding: 10rpx 0;
  color: #333;
}

.input-field:focus {
  border-bottom-color: #FF87B5;
}

.input-counter {
  position: absolute;
  right: 0;
  bottom: -40rpx;
  font-size: 24rpx;
  color: #999;
}

.buttons {
  display: flex;
  justify-content: space-between;
  margin-top: 80rpx;
}

.cancel-btn, .save-btn {
  flex: 1;
  margin: 0 20rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: 32rpx;
}

.cancel-btn {
  background-color: #f5f5f5;
  color: #666;
  margin-left: 0;
}

.save-btn {
  background-color: #FF87B5;
  color: #fff;
  margin-right: 0;
}

.save-btn[disabled] {
  opacity: 0.6;
  background-color: #FFD6E7;
}

button::after {
  border: none;
} 