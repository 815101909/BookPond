/* 听一听页面样式 */
page {
  background: #E8F5E9;
}

.listen-container {
  width: 100%;
  min-height: 100vh;
  background: #E8F5E9;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* 积分顶部导航栏 */
.points-navbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #FFFEF0;
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  flex-wrap: wrap;
  gap: 12rpx;
}

/* 积分模式标签 */
.points-mode {
  display: flex;
  align-items: center;
  background: #1B5E20;
  padding: 10rpx 16rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(27, 94, 32, 0.2);
  margin-right: 16rpx;
  flex-shrink: 0;
}

.mode-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.mode-text {
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: bold;
  letter-spacing: 1rpx;
}

.points-display {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
  justify-content: flex-end;
  flex-wrap: wrap;
}

.points-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.points-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.points-info::after {
  content: '';
  position: absolute;
  right: -10rpx;
  height: 80%;
  width: 1rpx;
  background-color: #eee;
}

.points-info:last-child::after {
  display: none;
}

.points-label {
  font-size: 24rpx;
  color: #666666;
}

.points-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #FF9800;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.1);
}

/* 查看规则按钮 */
.view-rules {
  display: flex;
  align-items: center;
  background: #E8F5E9;
  padding: 6rpx 12rpx;
  border-radius: 20rpx;
  border: 1rpx solid #4CAF50;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.1);
  cursor: pointer;
  transition: all 0.2s ease;
  margin-left: 10rpx;
}

.view-rules:active {
  background: #C8E6C9;
  transform: scale(0.95);
}

.rules-text {
  font-size: 24rpx;
  color: #1B5E20;
  font-weight: 500;
}

.radio-wire {
  width: 5rpx;
  height: 35rpx;
  background-color: #333;
  position: relative;
  border-radius: 3rpx;
}

/* 电线顶部的小球样式 */
.radio-wire::after {
  content: '';
  position: absolute;
  top: -12rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 30% 30%, #ff8a8a, #ff6b6b);
  box-shadow: 0 2rpx 5rpx rgba(0, 0, 0, 0.4);
}

.radio-wire.wire-left {
  transform: rotate(-15deg);
  animation: wireWiggle1 3s ease-in-out infinite;
}

.radio-wire.wire-right {
  transform: rotate(15deg);
  animation: wireWiggle2 4s ease-in-out infinite;
}

/* 小电线摆动动画 */
@keyframes wireWiggle1 {
  0%, 100% { transform: rotate(-15deg); }
  50% { transform: rotate(-18deg); }
}

@keyframes wireWiggle2 {
  0%, 100% { transform: rotate(15deg); }
  50% { transform: rotate(18deg); }
}

.inline-player-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

/* 新闻封面样式 - 调整尺寸 */
.inline-news-cover {
  width: 240rpx;
  height: 170rpx;
  margin-right: 20rpx;
  border-radius: 10rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
  flex-shrink: 0;
  margin-top: 7rpx; /* 封面下移7rpx */
}

.news-cover-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* 封面旁的内容区域 */
.inline-content-container {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  flex: 1;
  padding: 10rpx 15rpx;
  height: 170rpx;
  box-sizing: border-box;
}

/* 音频标题 */
.inline-audio-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 10rpx;
  line-height: 42rpx;
  max-height: 84rpx; /* 两行文字的高度 */
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* 控制区域样式 */
.inline-controls-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  margin-top: 15rpx;
  margin-bottom: 5rpx;
  position: relative;
}

.inline-upper-controls {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 300rpx; /* 增加宽度以适应调整后的元素位置 */
  margin: 0 auto;
  position: relative;
  height: 60rpx;
}

/* 播放按钮样式 - 保持居中不变 */
.inline-radio-play-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background-color: #ff6b6b;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 4rpx 8rpx rgba(255, 107, 107, 0.5);
  transition: all 0.25s ease;
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  z-index: 2; /* 确保播放按钮在最上层 */
}

/* 确保声波线宽度合适 */
.inline-sound-waves {
  display: flex;
  align-items: center;
  height: 40rpx;
  width: 70rpx; /* 增加宽度 */
  position: absolute;
  left: 52rpx;
}

.inline-lower-controls {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 15rpx;
  width: 70%;
}

.inline-speed-value {
  font-size: 21rpx; /* 从22rpx减小到21rpx */
  color: #333;
  background-color: rgba(255, 255, 255, 0.7);
  padding: 9rpx 15rpx; /* 从10rpx 16rpx减小到9rpx 15rpx */
  border-radius: 20rpx;
  text-align: center;
  cursor: pointer;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
}

.inline-speed-value:active {
  transform: scale(0.95);
  box-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.1);
}

.inline-speed-selector {
  position: absolute;
  bottom: 100%;
  right: 0;
  background-color: white;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.15);
  border-radius: 8rpx;
  padding: 8rpx;
  z-index: 10;
  display: none;
  flex-direction: column;
  margin-bottom: 10rpx;
  min-width: 100rpx;
}

.inline-speed-selector.show {
  display: flex;
}

.inline-speed-option {
  padding: 8rpx 16rpx;
  font-size: 24rpx;
  color: #333;
  border-radius: 6rpx;
  margin: 2rpx 0;
  text-align: center;
}

.inline-speed-option:active {
  background-color: #f0f0f0;
}

.inline-speed-option.active {
  background-color: #ffebee;
  color: #e53935;
  font-weight: 500;
}

/* 内嵌习题按钮样式 */
.inline-quiz-buttons {
  display: flex;
  justify-content: space-between;
  margin-top: 5rpx; /* 从15rpx减少到5rpx，向上移动10rpx */
  gap: 20rpx;
}

/* 听力小贴士样式 */
.inline-listening-tips {
  flex: 1;
  background-color: #FFF9E6;
  border-radius: 12rpx;
  padding: 15rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.tips-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #FF6B6B;
  margin-bottom: 10rpx;
  display: flex;
  align-items: center;
}

.tips-title::before {
  content: "🎙️";
  margin-right: 8rpx;
}

.tips-content {
  font-size: 22rpx;
  color: #666;
  line-height: 1.5;
}

/* 右侧按钮列样式 */
.inline-buttons-column {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
  width: 160rpx; /* 从180rpx减少20rpx */
  padding-top: 15rpx; /* 添加顶部内边距，使按钮整体下移15rpx */
}

.inline-quiz-btn, .inline-transcript-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 16rpx;
  background-color: #f0f0f0;
  border-radius: 30rpx;
  transition: all 0.3s ease;
  width: 140rpx; /* 从160rpx减少20rpx */
  margin: 0 auto; /* 保留水平居中 */
}

.inline-quiz-btn {
  background-color: #FFE0E6; /* 从蓝色改为浅粉色 */
  color: #D8496A; /* 从深蓝色改为粉红色 */
}

.inline-transcript-btn {
  background-color: #FFEAEF; /* 从绿色改为浅粉色 */
  color: #D8496A; /* 从深绿色改为粉红色 */
}

.inline-quiz-btn:active, .inline-transcript-btn:active {
  transform: scale(0.95);
  opacity: 0.9;
}

.inline-btn-icon {
  font-size: 24rpx; /* 从28rpx减小 */
  margin-right: 6rpx; /* 从8rpx减小 */
}

.inline-btn-text {
  font-size: 22rpx; /* 从24rpx减小 */
}

.inline-transcript-btn.disabled {
  background-color: #f0f0f0;
  color: #9e9e9e;
  cursor: not-allowed;
}

/* 修改声波动画，只在播放状态显示 */
.inline-sound-waves.playing .wave-line:nth-child(1) {
  animation: sound-wave 0.7s ease-in-out infinite alternate;
  animation-delay: 0.1s;
  height: 20rpx;
}

.inline-sound-waves.playing .wave-line:nth-child(2) {
  animation: sound-wave 0.9s ease-in-out infinite alternate;
  animation-delay: 0.2s;
  height: 24rpx;
}

.inline-sound-waves.playing .wave-line:nth-child(3) {
  animation: sound-wave 0.6s ease-in-out infinite alternate;
  animation-delay: 0.3s;
  height: 28rpx;
}

.inline-sound-waves.playing .wave-line:nth-child(4) {
  animation: sound-wave 0.8s ease-in-out infinite alternate;
  animation-delay: 0.4s;
  height: 24rpx;
}

.inline-sound-waves.playing .wave-line:nth-child(5) {
  animation: sound-wave 1.1s ease-in-out infinite alternate;
  animation-delay: 0.5s;
  height: 20rpx;
}

/* 非播放状态下的声波样式 */
.inline-sound-waves:not(.playing) .wave-line {
  background-color: #ffe0e0;
}

.inline-sound-waves:not(.playing) .wave-line:nth-child(1) {
  height: 12rpx;
}

.inline-sound-waves:not(.playing) .wave-line:nth-child(2) {
  height: 16rpx;
}

.inline-sound-waves:not(.playing) .wave-line:nth-child(3) {
  height: 20rpx;
}

.inline-sound-waves:not(.playing) .wave-line:nth-child(4) {
  height: 16rpx;
}

.inline-sound-waves:not(.playing) .wave-line:nth-child(5) {
  height: 12rpx;
}

/* 声波动画关键帧 */
@keyframes sound-wave {
  0% {
    height: 16rpx;
    background-color: #ffe0e0;
  }
  100% {
    height: 32rpx;
    background-color: #ff6b6b;
  }
}

.inline-radio-play-btn:active {
  transform: scale(0.92) translateX(-50%);
  box-shadow: 0 2rpx 4rpx rgba(255, 107, 107, 0.4);
  background-color: #ff5252;
}

.play-icon {
  color: #fff;
  font-size: 28rpx;
  margin-left: 3rpx;
}

.inline-sound-waves .wave-line {
  width: 4rpx;
  height: 16rpx;
  background-color: #ffe0e0;
  margin: 0 2rpx;
  border-radius: 4rpx;
  transition: all 0.3s ease;
}

.inline-radio-play-btn:active {
  transform: scale(0.92) translateX(-50%);
  box-shadow: 0 2rpx 4rpx rgba(255, 107, 107, 0.4);
  background-color: #ff5252;
}

.play-icon {
  color: #fff;
  font-size: 28rpx;
  margin-left: 3rpx;
}

/* 速度控制样式 - 向右平移15rpx */
.inline-speed-control {
  position: absolute;
  right: 35rpx; /* 原50rpx向右平移15rpx */
  width: 60rpx;
  text-align: center;
}

.inline-speed-value {
  font-size: 22rpx;
  color: #333;
  background-color: rgba(255, 255, 255, 0.8);
  padding: 6rpx 12rpx;
  border-radius: 20rpx;
  text-align: center;
  cursor: pointer;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.1);
  transition: all 0.25s ease;
}

.inline-speed-value:active {
  transform: scale(0.92);
  background-color: rgba(255, 255, 255, 0.95);
}

.inline-speed-selector {
  position: absolute;
  bottom: 45rpx;
  right: -35rpx; /* 调整为与新的速度控制位置匹配 */
  background-color: white;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
  border-radius: 8rpx;
  padding: 8rpx 0;
  z-index: 100;
  opacity: 0;
  visibility: hidden;
  transform: translateY(10rpx);
  transition: all 0.3s ease;
  width: 100rpx;
}

.inline-speed-selector.show {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

.inline-speed-option {
  padding: 10rpx 12rpx;
  font-size: 22rpx;
  color: #333;
  border-radius: 6rpx;
  margin: 2rpx 0;
  text-align: center;
  transition: all 0.2s ease;
}

.inline-speed-option:active {
  background-color: #f5f5f5;
  transform: scale(0.97);
}

.inline-speed-option.active {
  background-color: #ffebee;
  color: #e53935;
  font-weight: 500;
}

/* 修改声波动画，只在播放状态显示 */
.inline-sound-waves.playing .wave-line:nth-child(1) {
  animation: sound-wave 0.7s ease-in-out infinite alternate;
  animation-delay: 0.1s;
  height: 20rpx;
}

.inline-sound-waves.playing .wave-line:nth-child(2) {
  animation: sound-wave 0.9s ease-in-out infinite alternate;
  animation-delay: 0.2s;
  height: 24rpx;
}

.inline-sound-waves.playing .wave-line:nth-child(3) {
  animation: sound-wave 0.6s ease-in-out infinite alternate;
  animation-delay: 0.3s;
  height: 28rpx;
}

.inline-sound-waves.playing .wave-line:nth-child(4) {
  animation: sound-wave 0.8s ease-in-out infinite alternate;
  animation-delay: 0.4s;
  height: 24rpx;
}

.inline-sound-waves.playing .wave-line:nth-child(5) {
  animation: sound-wave 1.1s ease-in-out infinite alternate;
  animation-delay: 0.5s;
  height: 20rpx;
}

/* 声波动画 */
@keyframes sound-wave {
  0% {
    height: 16rpx;
    background-color: #ffe0e0;
  }
  100% {
    height: 30rpx;
    background-color: #ff6b6b;
  }
}

/* 答案解析弹窗样式 */
.analysis-popup {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 999;
}

.analysis-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: -1;
}

.analysis-container {
  width: 85%;
  max-width: 650rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.15);
  display: flex;
  flex-direction: column;
  background-color: #FFFBE5; /* 浅黄色背景 */
  margin: 0 auto;
}

.analysis-header {
  width: 100%;
  padding: 24rpx 30rpx;
  background-color: #E8F5E9; /* 浅绿色背景 */
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.1);
  box-sizing: border-box;
  border-bottom: 1rpx solid #C8E6C9;
}

.analysis-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #2E7D32; /* 深绿色文字 */
}

.analysis-close {
  font-size: 40rpx;
  color: #2E7D32;
  line-height: 1;
  padding: 0 10rpx;
  cursor: pointer;
}

.analysis-content {
  width: 100%;
  max-height: 70vh;
  background-color: #FFFBE5;
  overflow-y: auto;
  padding: 20rpx;
  box-sizing: border-box;
}

.analysis-summary {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 30rpx;
  padding: 20rpx;
  background-color: #F1F8E9;
  border-radius: 12rpx;
  border: 1rpx solid #C8E6C9;
}

.summary-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #2E7D32;
  margin-bottom: 10rpx;
}

.summary-points {
  font-size: 28rpx;
  color: #388E3C;
}

.analysis-question {
  margin-bottom: 40rpx;
  padding: 24rpx;
  background: #FFFEF5;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  border: 1rpx solid #FFE8A8;
}

.question-status {
  font-size: 28rpx;
  font-weight: bold;
  padding: 4rpx 16rpx;
  border-radius: 30rpx;
}

.question-status.correct {
  background-color: #E8F5E9;
  color: #2E7D32;
}

.question-status.wrong {
  background-color: #FFEBEE;
  color: #C62828;
}

.answer-detail {
  margin: 16rpx 0;
  padding: 12rpx;
  background-color: #FFFEF5;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
}

.answer-label {
  font-size: 28rpx;
  color: #555;
  margin-bottom: 8rpx;
  font-weight: 500;
}

.answer-text {
  font-size: 28rpx;
  line-height: 1.5;
  padding: 8rpx 12rpx;
  border-radius: 6rpx;
}

.answer-text.correct {
  color: #2E7D32;
  background-color: #E8F5E9;
}

.answer-text.wrong {
  color: #C62828;
  background-color: #FFEBEE;
}

.answer-explanation {
  margin-top: 20rpx;
  padding: 16rpx;
  background-color: #FFF8E1;
  border-radius: 10rpx;
  border: 1rpx solid #FFE8A8;
}

.explanation-label {
  font-size: 28rpx;
  font-weight: bold;
  color: #8B6E22;
  display: block;
  margin-bottom: 8rpx;
}

.explanation-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}

.explanation-note {
  font-size: 24rpx;
  color: #999;
  font-style: italic;
  margin-top: 10rpx;
  text-align: center;
}

/* 题型和分值标注样式 */
.question-type-label {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
  font-size: 26rpx;
}

.question-type {
  background-color: #FFD6DE;
  color: #D8496A;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  font-weight: bold;
}

.question-points {
  color: #D8496A;
  margin-left: 8rpx;
  font-weight: bold;
}

.question-multi-note {
  color: #999;
  margin-left: 12rpx;
  font-size: 24rpx;
}

/* 题目样式 */
.quiz-question {
  margin-bottom: 30rpx; /* 从40rpx减小 */
  padding: 20rpx; /* 从24rpx减小 */
  background: #FFFAFA; /* 更浅的粉色作为问题背景 */
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  border: 1rpx solid #FFCAD4; /* 添加淡边框 */
}

.question-text {
  font-size: 30rpx; /* 从32rpx减小 */
  font-weight: 500;
  margin-bottom: 30rpx;
  line-height: 1.5;
  color: #333;
  display: block;
}

/* 答案解析页面的题型样式 */
.question-type-analysis {
  display: flex;
  align-items: center;
  margin: 0 12rpx;
}

.question-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  flex-wrap: wrap;
}

.question-status {
  border-radius: 6rpx;
  padding: 4rpx 10rpx;
  font-size: 24rpx;
  font-weight: bold;
  margin-left: auto;
}

.question-status.correct {
  background-color: #E8F5E9;
  color: #388E3C;
}

.question-status.wrong {
  background-color: #FFEBEE;
  color: #D32F2F;
}

/* 得分显示 */
.answer-scores {
  margin-top: 12rpx;
  text-align: right;
}

.score-earned {
  color: #D8496A;
  font-weight: bold;
  font-size: 28rpx;
  background-color: #FFECF0;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
}

/* 填空题样式 */
.fill-answer {
  margin-top: 20rpx;
  width: 100%;
}

.listen-container {
  width: 100%;
  min-height: 100vh;
  background: #E8F5E9;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* 积分顶部导航栏 */
.points-navbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #FFFEF0;
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  flex-wrap: wrap;
  gap: 12rpx;
}

/* 积分模式标签 */
.points-mode {
  display: flex;
  align-items: center;
  background: #1B5E20;
  padding: 10rpx 16rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(27, 94, 32, 0.2);
  margin-right: 16rpx;
  flex-shrink: 0;
}

.mode-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.mode-text {
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: bold;
  letter-spacing: 1rpx;
}

.points-display {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
  justify-content: flex-end;
  flex-wrap: wrap;
}

.points-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.points-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.points-info::after {
  content: '';
  position: absolute;
  right: -10rpx;
  height: 80%;
  width: 1rpx;
  background-color: #eee;
}

.points-info:last-child::after {
  display: none;
}

.points-label {
  font-size: 24rpx;
  color: #666666;
}

.points-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #FF9800;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.1);
}

/* 查看规则按钮 */
.view-rules {
  display: flex;
  align-items: center;
  background: #E8F5E9;
  padding: 6rpx 12rpx;
  border-radius: 20rpx;
  border: 1rpx solid #4CAF50;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.1);
  cursor: pointer;
  transition: all 0.2s ease;
  margin-left: 10rpx;
}

.view-rules:active {
  background: #C8E6C9;
  transform: scale(0.95);
}

.rules-text {
  font-size: 24rpx;
  color: #1B5E20;
  font-weight: 500;
}

/* 设置栏目样式 */
.settings-section {
  background: #FFFEF0;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.settings-row {
  display: flex;
  justify-content: space-between;
  width: 100%;
  margin-bottom: 16rpx;
}

.settings-row:last-child {
  margin-bottom: 0;
}

.settings-item {
  flex: 1;
  display: flex;
  align-items: center;
}

.settings-label {
  font-size: 28rpx;
  color: #333333;
  font-weight: bold;
  white-space: nowrap;
  margin-right: 12rpx;
  min-width: 70rpx;
}

/* 语言选择器 */
.language-settings {
  flex: 3;
  margin-right: 12rpx;
}

.language-selector {
  display: flex;
  align-items: center;
  padding: 12rpx 16rpx;
  background-color: #FFF9E6;
  border-radius: 8rpx;
  min-width: 160rpx;
  max-width: 320rpx;
  transition: all 0.3s ease;
}

.language-selector:active {
  background-color: #FFF3D1;
  transform: scale(0.98);
}

.language-flag {
  font-size: 28rpx;
  margin-right: 8rpx;
}

/* 日期选择器 */
.date-settings {
  flex: 2;
}

.date-selector {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 180rpx;
  background-color: #FFF9E6;
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
  transition: all 0.3s ease;
}

.date-selector:active {
  background-color: #FFF3D1;
  transform: scale(0.98);
}

.date-icon {
  font-size: 28rpx;
  flex-shrink: 0;
}

/* 难度选择器 */
.difficulty-row {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
}

.difficulty-selector {
  flex: 1;
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
}

.difficulty-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 12rpx;
  background-color: #FFF9E6;
  border-radius: 8rpx;
  transition: all 0.3s ease;
}

.difficulty-btn:active {
  background-color: #FFF3D1;
  transform: scale(0.98);
}

.difficulty-btn.active {
  background: #E8F5E9;
  color: #1B5E20;
  transform: translateY(-2rpx);
  box-shadow: 0 2rpx 8rpx rgba(76, 175, 80, 0.3);
}

.difficulty-icon {
  font-size: 28rpx;
}

.difficulty-name {
  font-size: 26rpx;
  font-weight: 500;
}

.selector-text {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.difficulty-row .settings-label {
  margin-top: 15rpx;
}

/* 音频类型选择 */
.audio-type-section {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.audio-type-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx;
  background: #FFFEF0;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
}

.audio-type-btn.active {
  background: #FFE4E8;
  transform: translateY(-2rpx);
  box-shadow: 0 6rpx 16rpx rgba(255, 107, 129, 0.2);
}

.type-icon {
  font-size: 36rpx;
}

.type-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

/* 音频播放器 */
.radio-player {
  background: #FFFEF0;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-top: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  position: relative; /* 添加相对定位 */
}

/* 电线装饰样式 */
.radio-wires {
  position: absolute;
  top: -35rpx;
  left: calc(50% - 195rpx); /* 向右平移30rpx */
  transform: translateX(-50%);
  display: flex;
  gap: 30rpx;
  z-index: 1;
}

.radio-wire {
  width: 5rpx;
  height: 35rpx;
  background-color: #333;
  position: relative;
  border-radius: 3rpx;
}

/* 电线顶部的小球样式 */
.radio-wire::after {
  content: '';
  position: absolute;
  top: -12rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 30% 30%, #ff8a8a, #ff6b6b);
  box-shadow: 0 2rpx 5rpx rgba(0, 0, 0, 0.4);
}

.radio-wire.wire-left {
  transform: rotate(-15deg);
  animation: wireWiggle1 3s ease-in-out infinite;
}

.radio-wire.wire-right {
  transform: rotate(15deg);
  animation: wireWiggle2 4s ease-in-out infinite;
}

/* 小电线摆动动画 */
@keyframes wireWiggle1 {
  0%, 100% { transform: rotate(-15deg); }
  50% { transform: rotate(-18deg); }
}

@keyframes wireWiggle2 {
  0%, 100% { transform: rotate(15deg); }
  50% { transform: rotate(18deg); }
}

.radio-content {
  display: flex;
  gap: 24rpx;
}

.audio-cover {
  width: 240rpx;
  height: 180rpx;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

.cover-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.audio-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.audio-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  line-height: 1.5;
  max-height: 84rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  text-align: center;
  margin-top: 40rpx;
}

/* 控制区域 */
.audio-controls {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  position: relative;
  width: 100%;
  max-width: 280rpx; /* 限制最大宽度，使元素更紧凑 */
  margin: 20rpx 0 0 calc(50% - 140rpx - 40rpx); /* 从居中位置向左平移40rpx */
  gap: 20rpx; /* 保持原有的间距 */
}

/* 声波动画 */
.sound-waves {
  display: flex;
  align-items: center;
  gap: 3rpx; /* 增加波形线间距 */
  width: 120rpx; /* 增加宽度以容纳更多线条 */
  height: 40rpx;
  justify-content: flex-end;
}

.wave-line {
  width: 4rpx; /* 增加波形线宽度 */
  height: 16rpx;
  background: #FFB5C0;
  border-radius: 2rpx;
  transition: all 0.3s ease;
}

.sound-waves.playing .wave-line {
  animation: soundWave 1s ease-in-out infinite;
}

.sound-waves.playing .wave-line:nth-child(2) { animation-delay: 0.1s; }
.sound-waves.playing .wave-line:nth-child(3) { animation-delay: 0.2s; }
.sound-waves.playing .wave-line:nth-child(4) { animation-delay: 0.3s; }
.sound-waves.playing .wave-line:nth-child(5) { animation-delay: 0.4s; }
.sound-waves.playing .wave-line:nth-child(6) { animation-delay: 0.5s; }
.sound-waves.playing .wave-line:nth-child(7) { animation-delay: 0.6s; }
.sound-waves.playing .wave-line:nth-child(8) { animation-delay: 0.7s; }
.sound-waves.playing .wave-line:nth-child(9) { animation-delay: 0.8s; }

/* 调整非播放状态的声波样式 */
.sound-waves:not(.playing) .wave-line {
  background-color: #ffe0e0;
}

.sound-waves:not(.playing) .wave-line:nth-child(1) { height: 10rpx; }
.sound-waves:not(.playing) .wave-line:nth-child(2) { height: 12rpx; }
.sound-waves:not(.playing) .wave-line:nth-child(3) { height: 15rpx; }
.sound-waves:not(.playing) .wave-line:nth-child(4) { height: 18rpx; }
.sound-waves:not(.playing) .wave-line:nth-child(5) { height: 20rpx; }
.sound-waves:not(.playing) .wave-line:nth-child(6) { height: 18rpx; }
.sound-waves:not(.playing) .wave-line:nth-child(7) { height: 15rpx; }
.sound-waves:not(.playing) .wave-line:nth-child(8) { height: 12rpx; }
.sound-waves:not(.playing) .wave-line:nth-child(9) { height: 10rpx; }

/* 播放按钮 */
.play-button {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  background: #FF6B81;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 129, 0.3);
  transition: all 0.3s ease;
  flex-shrink: 0;
  z-index: 2;
  position: relative;
}

.play-button:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 6rpx rgba(255, 107, 129, 0.2);
}

.play-icon {
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 15rpx 0 15rpx 26rpx;
  border-color: transparent transparent transparent white;
  margin-left: 4rpx;
}

.play-icon.pause {
  width: 21rpx; /* 从26rpx缩小5rpx */
  height: 25rpx; /* 从30rpx再缩小5rpx */
  border-style: double;
  border-width: 0 0 0 21rpx; /* 从26rpx缩小5rpx */
  border-color: white;
  margin-left: 20rpx; /* 从10rpx增加到20rpx */
}

/* 倍速控制 */
.speed-control {
  padding: 6rpx 12rpx; /* 减少内边距 */
  background: rgba(255, 107, 129, 0.1);
  border-radius: 20rpx;
  transition: all 0.3s ease;
  height: 36rpx; /* 稍微调整高度 */
  display: flex;
  align-items: center;
}

.speed-value {
  font-size: 22rpx; /* 稍微调整字体大小 */
  color: #FF6B81;
  font-weight: 500;
}

.speed-control:active {
  transform: scale(0.95);
  background: rgba(255, 107, 129, 0.15);
}

@keyframes soundWave {
  0%, 100% { height: 16rpx; }
  50% { height: 32rpx; }
}

/* 简化后的习题训练营样式 */
.exercise-camp {
  background: #FFFEF0;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-top: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

/* 标题样式 */
.camp-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.camp-icon {
  font-size: 36rpx;
  margin-right: 10rpx;
}

.camp-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

/* 题目内容区域 */
.exercise-content {
  background: rgba(255, 255, 255, 0.6);
  border-radius: 12rpx;
  padding: 20rpx;
}

/* 题型标签 */
.exercise-type-badge {
  display: inline-block;
  background: rgba(255, 107, 129, 0.1);
  color: #FF6B81;
  font-size: 26rpx;
  font-weight: 500;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
}

/* 题目文本 */
.exercise-question {
  font-size: 30rpx;
  color: #333;
  line-height: 1.5;
  margin-bottom: 24rpx;
  font-weight: 500;
}

/* 选项区域 */
.exercise-options {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* 单个选项 */
.option-item {
  display: flex;
  align-items: center;
  padding: 16rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 10rpx;
  border: 1rpx solid #eee;
  transition: all 0.3s ease;
}

.option-item:active {
  background: #FFF9E6;
  transform: scale(0.99);
}

/* 选中的单选选项样式 */
.option-item.selected {
  background: #FFF3D1;
  border-color: #FFCC80;
}

.option-item.selected .option-letter {
  background: #FFCC80;
  color: #fff;
}

/* 选项前的字母标记 */
.option-letter {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  background: #F3F3F3;
  border-radius: 50%;
  margin-right: 16rpx;
  font-size: 24rpx;
  color: #666;
}

.option-text {
  font-size: 28rpx;
  color: #333;
}

/* 多选题选项样式 */
.multi-option.selected {
  background: #FFF9E6;
  border-color: #FFCC80;
}

.multi-option.selected .option-letter {
  background: #FFCC80;
  color: #fff;
}

/* 提交按钮 */
.multi-submit, .fill-submit, .single-submit {
  margin-top: 24rpx;
  background: #FF6B81;
  color: white;
  font-size: 28rpx;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 10rpx;
  transition: all 0.3s ease;
}

.multi-submit:active, .fill-submit:active, .single-submit:active {
  background: #FF5A70;
  transform: scale(0.98);
}

/* 填空题输入框 */
.exercise-fill-blank {
  display: flex;
  flex-direction: column;
}

.fill-input {
  padding: 16rpx;
  background: white;
  border: 1rpx solid #eee;
  border-radius: 10rpx;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
}

/* 移除之前不需要的样式 */
.difficulty-info,
.difficulty-badge,
.exercise-rules,
.progress-section {
  display: none;
}

/* 结果弹窗样式 */
.result-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.result-content {
  width: 80%;
  max-width: 600rpx;
  background: white;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 0 20rpx rgba(0, 0, 0, 0.2);
  display: flex;
  flex-direction: column;
  max-height: 80vh;
}

/* 结果头部 */
.result-header {
  padding: 30rpx 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.result-header.correct {
  background: linear-gradient(to right, #4CAF50, #8BC34A);
  color: white;
}

.result-header.incorrect {
  background: linear-gradient(to right, #FF5252, #FF8A80);
  color: white;
}

.result-status {
  display: flex;
  align-items: center;
}

.status-icon {
  font-size: 40rpx;
  margin-right: 10rpx;
  font-weight: bold;
}

.status-text {
  font-size: 32rpx;
  font-weight: 500;
}

.result-points {
  background: rgba(255, 255, 255, 0.3);
  padding: 8rpx 16rpx;
  border-radius: 30rpx;
}

.points-text {
  font-size: 28rpx;
  font-weight: bold;
}

/* 反馈信息 */
.result-feedback {
  padding: 20rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  border-bottom: 1px solid #eee;
}

/* 正确答案 */
.result-answer {
  padding: 20rpx;
  border-bottom: 1px solid #eee;
}

.answer-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #666;
  margin-bottom: 10rpx;
}

.answer-text {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

/* 答案解析 */
.result-explanation {
  padding: 20rpx;
  max-height: 300rpx;
  overflow-y: auto;
}

.explanation-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #666;
  margin-bottom: 10rpx;
}

.explanation-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}

/* 按钮区域 */
.result-actions {
  padding: 20rpx;
  display: flex;
  justify-content: space-between;
  border-top: 1px solid #eee;
}

.action-btn {
  flex: 1;
  padding: 16rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  border-radius: 10rpx;
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 10rpx;
}

.action-btn:active {
  background: #f5f5f5;
}

.action-btn.favorite {
  color: #FF6B81;
}

.favorite-icon {
  margin-right: 6rpx;
  font-size: 24rpx;
}

/* 重复作答不计分提示 */
.result-no-points {
  background: rgba(255, 255, 255, 0.3);
  padding: 8rpx 16rpx;
  border-radius: 30rpx;
}

.no-points-text {
  font-size: 24rpx;
  font-style: italic;
  color: rgba(255, 255, 255, 0.8);
}

/* 添加积分规则弹窗的样式 */
.rules-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.rules-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.6);
  z-index: 1;
}

.rules-content {
  position: relative;
  width: 85%;
  max-width: 650rpx;
  max-height: 85vh;
  background-color: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  z-index: 2;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.2);
  display: flex;
  flex-direction: column;
}

.rules-header {
  padding: 30rpx 24rpx;
  background: linear-gradient(to right, #FF6B81, #FF8E9E);
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
}

.rules-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  text-align: center;
}

.rules-close {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 50rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #fff;
  font-weight: bold;
}

.rules-body {
  padding: 30rpx 24rpx;
  overflow-y: auto;
  flex: 1;
  background-color: #FFFEF0;
}

.rule-item {
  display: flex;
  margin-bottom: 36rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx dashed #eee;
}

.rule-item:last-child {
  margin-bottom: 20rpx;
  border-bottom: none;
}

.rule-icon {
  font-size: 48rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.rule-text {
  flex: 1;
}

.rule-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.rule-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

.points-details {
  display: flex;
  justify-content: space-around;
  margin-top: 20rpx;
  padding: 24rpx;
  background: #FFF9F9;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.point-detail {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.point-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #FF6B81;
  margin-bottom: 8rpx;
}

.point-label {
  font-size: 22rpx;
  color: #666;
}

.rules-footer {
  padding: 24rpx;
  display: flex;
  justify-content: center;
  background-color: #fff;
  border-top: 1rpx solid #f0f0f0;
}

.rules-btn {
  width: 70%;
  padding: 18rpx 0;
  text-align: center;
  background: #FF6B81;
  color: #fff;
  font-size: 30rpx;
  font-weight: bold;
  border-radius: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 129, 0.3);
  transition: all 0.3s;
}

.rules-btn:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 6rpx rgba(255, 107, 129, 0.3);
}

/* 自定义小字体提示框样式 */
.custom-toast {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: rgba(0, 0, 0, 0.7);
  padding: 16rpx 24rpx;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.3s;
  z-index: 9999;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
  max-width: 70%;
}

.custom-toast.visible {
  opacity: 1;
}

.custom-toast.success {
  background: rgba(76, 175, 80, 0.9);
}

.custom-toast-icon {
  color: #fff;
  font-size: 30rpx;
  margin-right: 8rpx;
}

.custom-toast-text {
  color: #fff;
  font-size: 24rpx; /* 小号字体 */
  text-align: center;
  line-height: 1.4;
  font-weight: normal;
}

/* 没有内容提示样式 */
.no-content-tip {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 60rpx 24rpx;
  margin-top: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 300rpx;
}

.no-content-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  color: #BDBDBD;
}

.no-content-text {
  font-size: 32rpx;
  color: #757575;
  font-weight: bold;
  margin-bottom: 16rpx;
  text-align: center;
}

.no-content-subtext {
  font-size: 28rpx;
  color: #9E9E9E;
  text-align: center;
}
