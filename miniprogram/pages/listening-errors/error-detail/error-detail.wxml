<view class="container">
  <view class="header">
    <view class="back-btn" bindtap="goBack">
      <text class="back-icon">←</text>
      <text>返回</text>
    </view>
    <text class="title">错题详情</text>
  </view>

  <view class="exercise-card" wx:if="{{mistake}}">
    <!-- 问题部分 -->
    <view class="question-section">
      <view class="question-text">{{mistake.exercise.question}}</view>
    </view>
    
    <!-- 选项部分 -->
    <view class="options-section" wx:if="{{mistake.exercise.type === 'single' || mistake.exercise.type === 'multiple'}}">
      <block wx:for="{{mistake.exercise.options}}" wx:key="index">
        <view class="option-item {{mistake.exercise.answer === index || (Array.isArray(mistake.exercise.answer) && mistake.exercise.answer.includes(index)) ? 'correct' : ''}} {{(mistake.user_answer === index) || (Array.isArray(mistake.user_answer) && mistake.user_answer.includes(index)) ? 'selected' : ''}}">
          <text class="option-letter">{{optionLetters[index]}}</text>
          <text class="option-text">{{item}}</text>
          <text class="option-mark" wx:if="{{mistake.exercise.answer === index || (Array.isArray(mistake.exercise.answer) && mistake.exercise.answer.includes(index))}}">✓</text>
          <text class="option-mark wrong" wx:elif="{{(mistake.user_answer === index) || (Array.isArray(mistake.user_answer) && mistake.user_answer.includes(index))}}">✗</text>
        </view>
      </block>
    </view>
    
    <!-- 解析部分 -->
    <view class="explanation-section">
      <view class="section-title">解析</view>
      <view class="explanation-text">{{mistake.exercise.explanation || '暂无解析'}}</view>
    </view>
    
    <!-- 用户答案与正确答案对比 -->
    <view class="answer-comparison">
      <view class="section-title">答案对比</view>
      
      <view class="comparison-row">
        <view class="label">正确答案:</view>
        <view class="value correct">
          <block wx:if="{{mistake.exercise.type === 'single'}}">
            {{optionLetters[mistake.exercise.answer]}}
          </block>
          <block wx:elif="{{mistake.exercise.type === 'multiple'}}">
            <block wx:for="{{mistake.exercise.answer}}" wx:key="*this">
              {{optionLetters[item]}}{{index < mistake.exercise.answer.length-1 ? ', ' : ''}}
            </block>
          </block>
        </view>
      </view>
      
      <view class="comparison-row">
        <view class="label">你的答案:</view>
        <view class="value incorrect">
          <block wx:if="{{mistake.exercise.type === 'single'}}">
            {{mistake.user_answer !== null && mistake.user_answer !== undefined ? optionLetters[mistake.user_answer] : '未作答'}}
          </block>
          <block wx:elif="{{mistake.exercise.type === 'multiple'}}">
            <block wx:if="{{mistake.user_answer && mistake.user_answer.length > 0}}">
              <block wx:for="{{mistake.user_answer}}" wx:key="*this">
                {{optionLetters[item]}}{{index < mistake.user_answer.length-1 ? ', ' : ''}}
              </block>
            </block>
            <block wx:else>未作答</block>
          </block>
        </view>
      </view>
    </view>
    
    <!-- 音频控制部分 -->
    <view class="audio-section">
      <view class="audio-controls">
        <view class="play-btn {{isPlaying ? 'playing' : ''}}" bindtap="togglePlay">
          <text class="play-icon">{{isPlaying ? '❚❚' : '▶'}}</text>
        </view>
        
        <view class="speed-controls">
          <text class="speed-label">速度:</text>
          <view class="speed-options">
            <view class="speed-btn {{playbackSpeed === 0.8 ? 'active' : ''}}" bindtap="setPlaybackSpeed" data-speed="0.8">0.8x</view>
            <view class="speed-btn {{playbackSpeed === 1.0 ? 'active' : ''}}" bindtap="setPlaybackSpeed" data-speed="1.0">1.0x</view>
            <view class="speed-btn {{playbackSpeed === 1.25 ? 'active' : ''}}" bindtap="setPlaybackSpeed" data-speed="1.25">1.25x</view>
            <view class="speed-btn {{playbackSpeed === 1.5 ? 'active' : ''}}" bindtap="setPlaybackSpeed" data-speed="1.5">1.5x</view>
          </view>
        </view>
      </view>
      
      <view class="audio-status" wx:if="{{!audioLoaded}}">
        <text>音频加载中...</text>
      </view>
    </view>
  </view>
  
  <view class="empty-state" wx:else>
    <text class="empty-icon">🔍</text>
    <text class="empty-text">错题数据不存在</text>
  </view>
  
  <!-- 底部操作栏 -->
  <view class="bottom-actions" wx:if="{{mistake}}">
    <view class="action-btn review {{mistake.is_reviewed ? 'disabled' : ''}}" bindtap="markAsReviewed" wx:if="{{!mistake.is_reviewed}}">
      <text class="action-icon">✓</text>
      <text class="action-text">标记为已复习</text>
    </view>
    <view class="action-btn practice" bindtap="startPractice">
      <text class="action-icon">▶</text>
      <text class="action-text">开始练习</text>
    </view>
  </view>
</view> 