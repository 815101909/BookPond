/* 错题详情页样式 */
.container {
  padding: 0 30rpx 120rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.header {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
  margin-bottom: 30rpx;
  position: relative;
  height: 90rpx;
  width: 100%;
}

.back-btn {
  display: flex;
  align-items: center;
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  z-index: 10;
}

.back-icon {
  font-size: 40rpx;
  margin-right: 10rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
}

.exercise-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  margin-bottom: 30rpx;
}

.question-section {
  margin-bottom: 30rpx;
}

.question-text {
  font-size: 32rpx;
  line-height: 1.5;
  color: #333;
}

.options-section {
  margin-bottom: 30rpx;
}

.option-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx;
  border-radius: 10rpx;
  background-color: #f8f8f8;
  margin-bottom: 20rpx;
  position: relative;
  border: 2rpx solid transparent;
  min-height: 60rpx;
}

.option-item.correct {
  background-color: rgba(82, 196, 26, 0.1);
  border-color: #52c41a;
}

.option-item.selected {
  background-color: rgba(245, 34, 45, 0.1);
  border-color: #f5222d;
}

.option-letter {
  min-width: 40rpx;
  margin-right: 20rpx;
  font-weight: bold;
  color: #666;
  flex-shrink: 0;
}

.option-text {
  flex: 1;
  line-height: 1.5;
  padding-right: 50rpx; /* 为对错标记留出空间 */
}

.option-mark {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 32rpx;
  font-weight: bold;
  color: #52c41a;
}

.option-mark.wrong {
  color: #f5222d;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #333;
}

.explanation-section {
  margin-bottom: 30rpx;
  padding-top: 20rpx;
  border-top: 2rpx dashed #eee;
}

.explanation-text {
  font-size: 28rpx;
  line-height: 1.6;
  color: #666;
}

.answer-comparison {
  margin-bottom: 30rpx;
  padding-top: 20rpx;
  border-top: 2rpx dashed #eee;
}

.comparison-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.label {
  width: 160rpx;
  font-size: 28rpx;
  color: #666;
  flex-shrink: 0;
  text-align: right;
  padding-right: 20rpx;
}

.value {
  font-size: 28rpx;
  font-weight: bold;
  flex: 1;
}

.value.correct {
  color: #52c41a;
}

.value.incorrect {
  color: #f5222d;
}

.audio-section {
  padding-top: 20rpx;
  border-top: 2rpx dashed #eee;
}

.audio-controls {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.play-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #1890ff;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 42rpx;
}
.play-icon{
  margin-left: 5rpx;
}

.play-btn.playing {
  background-color: #ff7875;
}

.speed-controls {
  display: flex;
  align-items: center;
}

.speed-label {
  margin-right: 20rpx;
  font-size: 28rpx;
  color: #666;
}

.speed-options {
  display: flex;
}

.speed-btn {
  padding: 10rpx 20rpx;
  margin: 0 10rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  background-color: #f0f0f0;
}

.speed-btn.active {
  background-color: #1890ff;
  color: white;
}

.audio-status {
  text-align: center;
  margin-top: 20rpx;
  color: #999;
  font-size: 28rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
}

.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 20rpx 30rpx;
  background-color: white;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.action-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 10rpx;
}

.action-btn.review {
  background-color: #52c41a;
  color: white;
}

.action-btn.practice {
  background-color: #1890ff;
  color: white;
}

.action-btn.disabled {
  background-color: #d9d9d9;
  color: #999;
}

.action-icon {
  margin-right: 16rpx;
  font-size: 28rpx;
}

.action-text {
  font-size: 28rpx;
} 