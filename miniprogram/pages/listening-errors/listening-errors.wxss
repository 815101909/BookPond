/* 听力错题页面样式 */
.container {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100vh;
  background-color: #e8f5e9; /* 浅绿色背景 */
  padding: 30rpx;
  box-sizing: border-box;
}

.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
  padding-bottom: 20rpx;
  border-bottom: 1px solid #e0e0e0;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #888;
}

.error-list {
  flex: 1;
  overflow-y: auto;
  width: 100%;
}

.error-item {
  background-color: #fff;
  border-radius: 16rpx;
  margin-bottom: 30rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.error-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.error-type-info {
  display: flex;
  align-items: center;
}

.error-type {
  font-size: 28rpx;
  font-weight: bold;
  color: #4caf50;
  margin-right: 20rpx;
}

.difficulty-tag {
  font-size: 24rpx;
  color: #ff9800;
  background-color: rgba(255, 152, 0, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.difficulty-tag.cocoon {
  color: #2196f3;
  background-color: rgba(33, 150, 243, 0.1);
}

.difficulty-tag.soar {
  color: #9c27b0;
  background-color: rgba(156, 39, 176, 0.1);
}

.error-date {
  font-size: 24rpx;
  color: #999;
}

.error-content {
  position: relative;
  margin-bottom: 20rpx;
}

.question-container {
  margin-bottom: 20rpx;
}

.error-text {
  font-size: 30rpx;
  color: #333;
  line-height: 1.4;
}

.error-options {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.option {
  font-size: 28rpx;
  color: #666;
  padding: 10rpx;
  border-radius: 8rpx;
  background-color: #f5f5f5;
}

.option.correct {
  color: #4caf50;
  background-color: rgba(76, 175, 80, 0.1);
}

.fill-answer {
  margin-top: 10rpx;
  padding: 10rpx;
  border-radius: 8rpx;
  background-color: rgba(76, 175, 80, 0.1);
}

.answer-label {
  font-size: 28rpx;
  color: #666;
}

.answer-text {
  font-size: 28rpx;
  color: #4caf50;
  font-weight: bold;
}

.answer-status {
  position: absolute;
  top: 0;
  right: 0;
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.answer-status.correct {
  color: #4caf50;
  background-color: rgba(76, 175, 80, 0.1);
}

.answer-status.incorrect {
  color: #f44336;
  background-color: rgba(244, 67, 54, 0.1);
}

.error-actions {
  display: flex;
  justify-content: space-around;
  padding-top: 20rpx;
  border-top: 1px solid #f0f0f0;
}

.action-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  padding: 10rpx 20rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.practice {
  background-color: #e0f7fa;
  color: #0288d1;
  flex: 2;
  margin-right: 10rpx;
}

.practice-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.practice.disabled {
  background-color: #f5f5f5;
  color: #999;
}

.delete {
  background-color: #ffebee;
  color: #f44336;
  flex: 1;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.empty-tip {
  font-size: 26rpx;
  color: #bbb;
}

.empty-action {
  margin-top: 30rpx;
}

.to-listen-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 200rpx;
  height: 80rpx;
  background-color: #e0f7fa;
  color: #0288d1;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.bottom-actions {
  display: flex;
  justify-content: space-around;
  padding: 30rpx 0;
  border-top: 1px solid #e0e0e0;
}

.bottom-actions .action-btn {
  flex: 1;
  flex-direction: row;
  justify-content: center;
  background-color: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin: 0 10rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.bottom-actions .action-icon {
  margin-right: 10rpx;
  font-size: 36rpx;
}

.bottom-actions .action-text {
  font-size: 28rpx;
  color: #666;
}

.back {
  background-color: #f5f5f5;
}

.practice-new {
  background-color: #e0f7fa;
}

.pretty-btn {
  background: linear-gradient(to right, #f48fb1, #f48fb1); /* 浅粉色渐变 */
  color: #333; /* 黑色文字 */
  padding: 15rpx 40rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  box-shadow: 0 4rpx 12rpx rgba(244, 143, 177, 0.3); /* 淡粉色阴影 */
  display: inline-block;
} 