<!-- 登录页面 -->
<view class="container">
  <!-- 顶部LOGO -->
  <view class="logo-section">
    <view class="logo-icon">
      <image wx:if="{{logoUrl}}" class="logo-image" src="{{logoUrl}}" mode="aspectFill"></image>
    </view>
    <text class="app-name">小舟摇书池</text>
    <text class="app-slogan">让学习更简单，让进步更快乐</text>
  </view>



  <!-- 登录方式选择区域 -->
  <view class="login-methods">
    <view class="login-card">
      <view class="login-header">
        <text class="login-subtitle">快速登录，开启学习之旅</text>
      </view>
      
      <button class="login-btn wechat-btn" bindtap="handleGetUserProfile">
        <text>微信一键登录</text>
      </button>
      
      <button class="login-btn phone-btn" open-type="getPhoneNumber" bindgetphonenumber="getPhoneNumber">
        <text>手机号快捷登录</text>
      </button>
    </view>
  </view>

  <!-- 底部用户协议勾选区域 -->
  <view class="agreement-section">
    <checkbox-group bindchange="onPrivacyChecked">
      <label class="checkbox-container">
        <checkbox value="1" checked="{{isPrivacyChecked}}" color="#07c160"/>
        <text class="agreement-text">我已阅读并同意</text>
        <text class="link" bindtap="viewAgreement">《用户服务协议》</text>
        <text class="link" bindtap="viewPrivacy">《隐私政策》</text>
      </label>
    </checkbox-group>
  </view>

  <!-- 登录中遮罩层 -->
  <view class="loading-mask" wx:if="{{isLoggingIn}}">
    <view class="loading-content">
      <view class="loading-icon"></view>
      <text class="loading-text">登录中...</text>
    </view>
  </view>
</view>