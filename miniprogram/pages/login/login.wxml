<!-- 登录页面 -->
<view class="container">
  <!-- 顶部LOGO -->
  <view class="logo-section">
    <text class="app-name">小舟摇书池</text>
    <text class="app-slogan">让学习更简单，让进步更快乐</text>
  </view>

  <!-- 登录方式选择区域 -->
  <view class="login-methods">
    <block wx:if="{{loginMethod === 'wechat'}}">
      <!-- 微信登录 -->
      <view class="login-card">
        <view class="login-header">
          <text class="login-title">微信登录</text>
          <text class="login-subtitle">授权微信账号快速登录</text>
        </view>
        
        <button class="login-btn wechat-btn" bindtap="handleGetUserProfile">
          <image class="btn-icon" src="/images/icons/wechat.png" mode="aspectFit"></image>
          <text>微信一键登录</text>
        </button>
        
        <view class="other-login">
          <view class="divider-box">
            <view class="divider"></view>
            <text class="divider-text">其他登录方式</text>
            <view class="divider"></view>
          </view>
          
          <view class="other-methods" bindtap="switchLoginMethod" data-method="phone">
            <view class="method-item" bindtap="switchLoginMethod" data-method="phone">
              <text>手机号登录</text>
            </view>
          </view>
        </view>
      </view>
    </block>
    
    <block wx:if="{{loginMethod === 'phone'}}">
      <!-- 手机号登录 -->
      <view class="login-card">
        <view class="login-header">
          <text class="login-title">手机号授权</text>
          <text class="login-subtitle">授权微信绑定的手机号快速登录</text>
        </view>
        
        <button class="login-btn phone-btn" open-type="getPhoneNumber" bindgetphonenumber="getPhoneNumber">
          <image class="btn-icon" src="/images/icons/phone.png" mode="aspectFit"></image>
          <text>手机号快捷登录</text>
        </button>
        
        <view class="other-login">
          <view class="divider-box">
            <view class="divider"></view>
            <text class="divider-text">其他登录方式</text>
            <view class="divider"></view>
          </view>
          
          <view class="other-methods" bindtap="switchLoginMethod" data-method="wechat">
            <view class="method-item">
              <text>微信登录</text>
            </view>

          </view>
        </view>
      </view>
    </block>
    

  </view>

  <!-- 底部用户协议勾选区域 -->
  <view class="agreement-section">
    <checkbox-group bindchange="onPrivacyChecked">
      <label class="checkbox-container">
        <checkbox value="1" checked="{{isPrivacyChecked}}" color="#07c160"/>
        <text class="agreement-text">我已阅读并同意</text>
      </label>
    </checkbox-group>
    <view class="agreement-links">
      <text class="link" bindtap="viewAgreement">《用户服务协议》</text>
      <text>和</text>
      <text class="link" bindtap="viewPrivacy">《隐私政策》</text>
    </view>
  </view>

  <!-- 登录中遮罩层 -->
  <view class="loading-mask" wx:if="{{isLoggingIn}}">
    <view class="loading-content">
      <view class="loading-icon"></view>
      <text class="loading-text">登录中...</text>
    </view>
  </view>
</view>