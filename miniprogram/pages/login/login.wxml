<!-- 登录页面 -->
<view class="login-container">
  <!-- 顶部LOGO -->
  <view class="logo-section">
    <image class="logo" src="/images/logo.png" mode="aspectFit"></image>
    <text class="app-name">九域英语</text>
    <text class="app-slogan">让学习更简单，让进步更快乐</text>
  </view>
  
  <!-- 登录方式选择区域 -->
  <view class="login-methods">
    <block wx:if="{{loginMethod === 'wechat'}}">
      <!-- 微信登录 -->
      <view class="login-card">
        <view class="login-header">
          <text class="login-title">微信登录</text>
          <text class="login-subtitle">授权微信账号快速登录</text>
        </view>
        
        <button class="login-btn wechat-btn" bindtap="handleGetUserProfile">
          <image class="btn-icon" src="/images/wechat-icon.png" mode="aspectFit"></image>
          <text>微信一键登录</text>
        </button>
        
        <view class="other-login">
          <view class="divider-box">
            <view class="divider"></view>
            <text class="divider-text">其他登录方式</text>
            <view class="divider"></view>
          </view>
          
          <view class="other-methods">
            <view class="method-item" bindtap="switchLoginMethod" data-method="phone">
              <view class="method-icon phone-icon"></view>
              <text>手机号登录</text>
            </view>
            <view class="method-item" bindtap="switchLoginMethod" data-method="code">
              <view class="method-icon sms-icon"></view>
              <text>验证码登录</text>
            </view>
          </view>
        </view>
      </view>
    </block>
    
    <block wx:if="{{loginMethod === 'phone'}}">
      <!-- 手机号登录 -->
      <view class="login-card">
        <view class="login-header">
          <text class="login-title">手机号授权</text>
          <text class="login-subtitle">授权微信绑定的手机号快速登录</text>
        </view>
        
        <button class="login-btn phone-btn" open-type="getPhoneNumber" bindgetphonenumber="getPhoneNumber">
          <image class="btn-icon" src="/images/phone-icon.png" mode="aspectFit"></image>
          <text>微信手机号快捷登录</text>
        </button>
        
        <view class="other-login">
          <view class="divider-box">
            <view class="divider"></view>
            <text class="divider-text">其他登录方式</text>
            <view class="divider"></view>
          </view>
          
          <view class="other-methods">
            <view class="method-item" bindtap="switchLoginMethod" data-method="wechat">
              <view class="method-icon wechat-icon"></view>
              <text>微信登录</text>
            </view>
            <view class="method-item" bindtap="switchLoginMethod" data-method="code">
              <view class="method-icon sms-icon"></view>
              <text>验证码登录</text>
            </view>
          </view>
        </view>
      </view>
    </block>
    
    <block wx:if="{{loginMethod === 'code'}}">
      <!-- 验证码登录 -->
      <view class="login-card">
        <view class="login-header">
          <text class="login-title">验证码登录</text>
          <text class="login-subtitle">输入手机号和验证码登录</text>
        </view>
        
        <view class="input-group">
          <view class="input-item">
            <view class="input-label">手机号</view>
            <view class="input-box">
              <input id="phoneInput" type="number" placeholder="请输入手机号" maxlength="11" />
            </view>
          </view>
          
          <view class="input-item">
            <view class="input-label">验证码</view>
            <view class="input-box with-button">
              <input type="number" bindinput="handleCodeInput" placeholder="请输入验证码" maxlength="6" />
              <button class="code-btn {{isCounting ? 'counting' : ''}}" bindtap="sendVerificationCode" disabled="{{isCounting}}">
                {{isCounting ? countdown + 's' : '获取验证码'}}
              </button>
            </view>
          </view>
        </view>
        
        <button class="login-btn code-login-btn" bindtap="loginWithPhoneAndCode">
          <text>登录</text>
        </button>
        
        <view class="other-login">
          <view class="divider-box">
            <view class="divider"></view>
            <text class="divider-text">其他登录方式</text>
            <view class="divider"></view>
          </view>
          
          <view class="other-methods">
            <view class="method-item" bindtap="switchLoginMethod" data-method="wechat">
              <view class="method-icon wechat-icon"></view>
              <text>微信登录</text>
            </view>
            <view class="method-item" bindtap="switchLoginMethod" data-method="phone">
              <view class="method-icon phone-icon"></view>
              <text>手机号登录</text>
            </view>
          </view>
        </view>
      </view>
    </block>
  </view>
  
  <!-- 底部用户协议勾选区域 -->
  <view class="agreement-section">
    <view class="checkbox-container" bindtap="togglePrivacyCheck">
      <view class="checkbox {{isPrivacyChecked ? 'checked' : ''}}">
        <view class="checkbox-inner" wx:if="{{isPrivacyChecked}}"></view>
      </view>
      <text class="agreement-text">我已阅读并同意</text>
    </view>
    <view class="agreement-links">
      <text class="link" bindtap="viewAgreement">《用户服务协议》</text>
      <text>和</text>
      <text class="link" bindtap="viewPrivacy">《隐私政策》</text>
    </view>
  </view>
  
  <!-- 登录中遮罩层 -->
  <view class="loading-mask" wx:if="{{isLoggingIn}}">
    <view class="loading-content">
      <view class="loading-icon"></view>
      <text class="loading-text">登录中...</text>
    </view>
  </view>
</view> 