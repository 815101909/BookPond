/* 登录页面样式 */
.login-container {
  position: relative;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: #f8f9fa;
  padding: 30rpx;
}

/* 顶部LOGO区域 */
.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 20rpx;
}

.app-name {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.app-slogan {
  font-size: 28rpx;
  color: #666;
}

/* 登录方式区域 */
.login-methods {
  flex: 1;
  margin-top: 20rpx;
}

.login-card {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.login-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.login-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
  display: block;
}

.login-subtitle {
  font-size: 26rpx;
  color: #999;
}

/* 登录按钮样式 */
.login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  margin-top: 30rpx;
  margin-bottom: 30rpx;
  border: none;
  position: relative;
}

.btn-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 10rpx;
}

.wechat-btn {
  background-color: #07c160;
  color: #fff;
}

.wechat-btn::after {
  border: none;
}

.phone-btn {
  background-color: #4a90e2;
  color: #fff;
}

.phone-btn::after {
  border: none;
}

.code-login-btn {
  background-color: #446dff;
  color: #fff;
}

/* 其他登录方式 */
.other-login {
  margin-top: 40rpx;
}

.divider-box {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.divider {
  flex: 1;
  height: 1px;
  background-color: #eee;
}

.divider-text {
  margin: 0 20rpx;
  font-size: 24rpx;
  color: #999;
}

.other-methods {
  display: flex;
  justify-content: center;
}

.method-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 0 40rpx;
}

.method-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  margin-bottom: 15rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background-position: center;
  background-repeat: no-repeat;
  background-size: 50rpx 50rpx;
}

.wechat-icon {
  background-color: rgba(7, 193, 96, 0.1);
  background-image: url('data:image/svg+xml;base64,');
}

.phone-icon {
  background-color: rgba(74, 144, 226, 0.1);
  background-image: url('data:image/svg+xml;base64,');
}

.sms-icon {
  background-color: rgba(68, 109, 255, 0.1);
  background-image: url('data:image/svg+xml;base64,');
}

.method-item text {
  font-size: 24rpx;
  color: #666;
}

/* 输入框样式 */
.input-group {
  margin-bottom: 30rpx;
}

.input-item {
  margin-bottom: 25rpx;
}

.input-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 15rpx;
}

.input-box {
  height: 90rpx;
  background-color: #f5f7fa;
  border-radius: 45rpx;
  padding: 0 30rpx;
  display: flex;
  align-items: center;
}

.input-box input {
  height: 90rpx;
  width: 100%;
  font-size: 28rpx;
}

.input-box.with-button {
  padding-right: 0;
  display: flex;
  justify-content: space-between;
}

.input-box.with-button input {
  flex: 1;
}

.code-btn {
  height: 80rpx;
  margin: 5rpx;
  padding: 0 30rpx;
  border-radius: 40rpx;
  background-color: #446dff;
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  white-space: nowrap;
}

.code-btn::after {
  border: none;
}

.code-btn.counting {
  background-color: #ccc;
  color: #fff;
}

/* 协议区域 */
.agreement-section {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.checkbox-container {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid #ccc;
  margin-right: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.checkbox.checked {
  border-color: #446dff;
  background-color: #446dff;
}

.checkbox-inner {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background-color: #fff;
}

.agreement-text {
  font-size: 26rpx;
  color: #666;
}

.agreement-links {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #666;
}

.link {
  color: #446dff;
}

/* 加载中遮罩 */
.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.loading-content {
  width: 200rpx;
  height: 200rpx;
  background-color: rgba(0, 0, 0, 0.7);
  border-radius: 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.loading-icon {
  width: 80rpx;
  height: 80rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  border-top-color: #fff;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #fff;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
} 