/* 登录页面样式 */
.container {
  position: relative;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: #e0ffe0; /* 浅绿色 */
  padding: 30rpx;
  box-sizing: border-box;
}

/* 顶部LOGO区域 */
.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.app-name {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.app-slogan {
  font-size: 28rpx;
  color: #666;
}

/* 登录方式区域 */
.login-methods {
  flex: 1;
  margin-top: 20rpx;
  width: 100%;
}

.login-card {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 30rpx;
}

.login-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.login-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
  display: block;
}

.login-subtitle {
  font-size: 26rpx;
  color: #999;
}

/* 登录按钮样式 */
.login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  margin-top: 30rpx;
  margin-bottom: 30rpx;
  border: none;
  position: relative;
  width: 100%;
  padding: 0;
}

.btn-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
}

.wechat-btn {
  background-color: #07c160;
  color: #fff;
}

.wechat-btn::after {
  border: none;
}

.wechat-btn[disabled] {
  background-color: #9fddb6;
  color: rgba(255, 255, 255, 0.8);
}

/* 其他登录方式 */
.other-login {
  margin-top: 40rpx;
}

.divider-box {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
}

.divider {
  flex: 1;
  height: 1px;
  background-color: #eee;
}

.divider-text {
  color: #999;
  font-size: 24rpx;
  margin: 0 20rpx;
}

.other-methods {
  display: flex;
  justify-content: center;
  gap: 60rpx;
  border: 1rpx solid #eee; /* 添加边框 */
  border-radius: 20rpx; /* 圆角 */
  padding: 30rpx; /* 内边距 */
  margin-top: 40rpx; /* 顶部外边距 */
  background-color: #fff; /* 背景色 */
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03); /* 轻微阴影 */
  width: 60%; /* 缩短宽度 */
  margin-left: auto;
  margin-right: auto;
}

.method-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 24rpx;
  color: #666;
}

.method-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f5f5f5;
}

/* 协议区域 */
.agreement-section {
  margin-top: auto;
  padding: 40rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.checkbox-container {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.agreement-text {
  font-size: 26rpx;
  color: #666;
  margin-left: 8rpx;
}

.agreement-links {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #666;
}

.link {
  color: #07c160;
  margin: 0 4rpx;
}

/* 加载中遮罩 */
.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.loading-content {
  width: 200rpx;
  height: 200rpx;
  background-color: rgba(0, 0, 0, 0.7);
  border-radius: 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.loading-icon {
  width: 80rpx;
  height: 80rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  border-top-color: #fff;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #fff;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* 输入框组样式 */
.input-group {
  margin-top: 30rpx;
}

.input-item {
  margin-bottom: 24rpx;
}

.input-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 12rpx;
}

.input-box {
  position: relative;
  height: 88rpx;
  border: 1px solid #e5e5e5;
  border-radius: 44rpx;
  padding: 0 30rpx;
  display: flex;
  align-items: center;
}

.input-box input {
  flex: 1;
  height: 100%;
  font-size: 28rpx;
}

.input-box.with-button {
  padding-right: 200rpx;
}

.code-btn {
  position: absolute;
  right: 8rpx;
  top: 50%;
  transform: translateY(-50%);
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 30rpx;
  font-size: 26rpx;
  color: #07c160;
  background: none;
  border: none;
  border-left: 1px solid #e5e5e5;
}

.code-btn::after {
  border: none;
}

.code-btn.counting {
  color: #999;
}

.code-login-btn {
  background-color: #07c160;
  color: #fff;
}

.phone-btn {
  background-color: #07c160;
  color: #fff;
}