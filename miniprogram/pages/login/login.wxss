/* 登录页面样式 */
.container {
  position: relative;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: linear-gradient(135deg, #f1f8f4 0%, #b8e6c1 50%, #66bb6a 100%);
  padding: 30rpx;
  box-sizing: border-box;
  overflow: hidden;
}

/* 顶部LOGO区域 */
.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0 30rpx;
  position: relative;
  z-index: 1;
  animation: fadeInDown 0.8s ease-out;
}

.logo-icon {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: rgba(7, 193, 96, 0.9);
  backdrop-filter: blur(10rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 10rpx;
  animation: float 3s ease-in-out infinite;
  box-shadow: 
    0 8rpx 24rpx rgba(7, 193, 96, 0.3),
    inset -2rpx -2rpx 8rpx rgba(0, 0, 0, 0.1),
    inset 2rpx 2rpx 8rpx rgba(255, 255, 255, 0.3);
  position: relative;
  overflow: hidden;
}

.logo-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
}

@keyframes float {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-10rpx);
  }
}

.app-name {
  font-size: 48rpx;
  font-weight: bold;
  color: #1a6f3f;
  margin-top: 50rpx;
  margin-bottom: 16rpx;
  text-shadow: 0 2rpx 8rpx rgba(255, 255, 255, 0.5);
  letter-spacing: 2rpx;
}

.app-slogan {
  font-size: 26rpx;
  color: #2d8659;
  text-shadow: 0 1rpx 3rpx rgba(255, 255, 255, 0.3);
}

@keyframes fadeInDown {
  from {
    opacity: 0;
    transform: translateY(-30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 特色功能展示 */
.features-section {
  display: flex;
  justify-content: space-between;
  padding: 0 20rpx;
  margin: 30rpx 0 40rpx;
  position: relative;
  z-index: 1;
  animation: fadeIn 0.8s ease-out 0.3s both;
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  padding: 20rpx 10rpx;
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(5rpx);
  border-radius: 20rpx;
  margin: 0 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.1);
  transition: all 0.3s ease;
}

.feature-item:active {
  transform: translateY(-5rpx);
  box-shadow: 0 6rpx 20rpx rgba(7, 193, 96, 0.15);
}

.feature-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
  animation: bounce 2s ease-in-out infinite;
}

.feature-item:nth-child(1) .feature-icon {
  animation-delay: 0s;
}

.feature-item:nth-child(2) .feature-icon {
  animation-delay: 0.2s;
}

.feature-item:nth-child(3) .feature-icon {
  animation-delay: 0.4s;
}

.feature-item:nth-child(4) .feature-icon {
  animation-delay: 0.6s;
}

@keyframes bounce {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-5rpx);
  }
}

.feature-text {
  font-size: 22rpx;
  color: #2d8659;
  font-weight: 500;
  text-align: center;
}

/* 登录方式区域 */
.login-methods {
  flex: 1;
  margin-top: 20rpx;
  width: 100%;
  position: relative;
  z-index: 1;
  animation: fadeInUp 0.8s ease-out 0.2s both;
}

.login-card {
  background: rgba(255, 255, 255, 0.3);
  backdrop-filter: blur(20rpx);
  border-radius: 32rpx;
  padding: 40rpx 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.6);
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.login-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.login-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
  display: block;
}

.login-subtitle {
  font-size: 26rpx;
  color: #999;
}

/* 登录权益提示 */
.benefits-tips {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 30rpx 0;
  margin-top: 20rpx;
}

.benefit-tip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  animation: slideInLeft 0.5s ease-out;
}

.benefit-tip:nth-child(1) {
  animation-delay: 0.1s;
}

.benefit-tip:nth-child(2) {
  animation-delay: 0.2s;
}

.benefit-tip:nth-child(3) {
  animation-delay: 0.3s;
}

@keyframes slideInLeft {
  from {
    opacity: 0;
    transform: translateX(-20rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

.tip-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #07c160 0%, #05a550 100%);
  color: #fff;
  font-size: 20rpx;
  font-weight: bold;
  flex-shrink: 0;
}

.tip-text {
  font-size: 26rpx;
  color: #666;
}

/* 登录按钮样式 */
.login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: 20rpx;
  font-size: 32rpx;
  font-weight: 500;
  margin-top: 40rpx;
  margin-bottom: 30rpx;
  border: none;
  position: relative;
  width: 100%;
  min-width: 420rpx;
  padding: 0;
  box-shadow: 0 6rpx 20rpx rgba(7, 193, 96, 0.3);
  transition: all 0.3s ease;
  overflow: hidden;
}

.login-btn:last-child {
  margin-top: 20rpx;
}

.login-btn::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 0;
  height: 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  transform: translate(-50%, -50%);
  transition: width 0.6s, height 0.6s;
}

.login-btn:active::before {
  width: 300rpx;
  height: 300rpx;
}

.btn-icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 16rpx;
  position: relative;
  z-index: 1;
}

.wechat-btn {
  background: linear-gradient(135deg, #07c160 0%, #05a550 100%);
  color: #fff;
  box-shadow: 0 6rpx 20rpx rgba(7, 193, 96, 0.3);
}

.wechat-btn::after {
  border: none;
}

.wechat-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.2);
}

.wechat-btn[disabled] {
  background: linear-gradient(135deg, #9fddb6 0%, #8ec9a4 100%);
  color: rgba(255, 255, 255, 0.8);
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.15);
}

/* 其他登录方式 */
.other-login {
  margin-top: 50rpx;
}

.divider-box {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
}

.divider {
  flex: 1;
  height: 1rpx;
  background: linear-gradient(to right, transparent, #ddd, transparent);
}

.divider-text {
  color: #999;
  font-size: 24rpx;
  margin: 0 20rpx;
  font-weight: 400;
}

.other-methods {
  display: flex;
  justify-content: center;
  gap: 60rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.05);
  border-radius: 24rpx;
  padding: 28rpx 40rpx;
  margin-top: 30rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.9) 0%, rgba(255, 255, 255, 0.7) 100%);
  backdrop-filter: blur(5rpx);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  width: 65%;
  margin-left: auto;
  margin-right: auto;
  transition: all 0.3s ease;
}

.other-methods:active {
  transform: scale(0.98);
  box-shadow: 0 1rpx 6rpx rgba(0, 0, 0, 0.03);
}

.method-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 26rpx;
  color: #07c160;
  font-weight: 500;
}

.method-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f5f5f5;
}

/* 协议区域 */
.agreement-section {
  margin-top: auto;
  padding: 40rpx 0 280rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  z-index: 1;
  animation: fadeIn 1s ease-out 0.4s both;
}

.checkbox-container {
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
}

.agreement-text {
  font-size: 26rpx;
  color: #2d8659;
  margin-left: 8rpx;
  text-shadow: 0 1rpx 2rpx rgba(255, 255, 255, 0.3);
}

.link {
  color: #07c160;
  font-weight: 500;
  font-size: 26rpx;
  text-decoration: underline;
  text-underline-offset: 3rpx;
  text-shadow: 0 1rpx 2rpx rgba(255, 255, 255, 0.3);
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

/* 平台优势 */
.advantages-section {
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 30rpx 40rpx;
  margin: 20rpx 0;
  position: relative;
  z-index: 1;
  animation: fadeIn 1s ease-out 0.5s both;
}

.advantage-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.advantage-icon {
  font-size: 32rpx;
  margin-bottom: 4rpx;
}

.advantage-text {
  font-size: 24rpx;
  color: #2d8659;
  font-weight: 400;
  white-space: nowrap;
}

/* 加载中遮罩 */
.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(5rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  animation: fadeIn 0.3s ease-out;
}

.loading-content {
  width: 220rpx;
  height: 220rpx;
  background: linear-gradient(135deg, rgba(84, 110, 122, 0.95) 0%, rgba(69, 90, 100, 0.95) 100%);
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.3);
}

.loading-icon {
  width: 80rpx;
  height: 80rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  border-top-color: #fff;
  border-right-color: #fff;
  animation: spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* 输入框组样式 */
.input-group {
  margin-top: 30rpx;
}

.input-item {
  margin-bottom: 24rpx;
}

.input-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 12rpx;
}

.input-box {
  position: relative;
  height: 88rpx;
  border: 1px solid #e5e5e5;
  border-radius: 44rpx;
  padding: 0 30rpx;
  display: flex;
  align-items: center;
}

.input-box input {
  flex: 1;
  height: 100%;
  font-size: 28rpx;
}

.input-box.with-button {
  padding-right: 200rpx;
}

.code-btn {
  position: absolute;
  right: 8rpx;
  top: 50%;
  transform: translateY(-50%);
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 30rpx;
  font-size: 26rpx;
  color: #07c160;
  background: none;
  border: none;
  border-left: 1px solid #e5e5e5;
}

.code-btn::after {
  border: none;
}

.code-btn.counting {
  color: #999;
}

.code-login-btn {
  background-color: #07c160;
  color: #fff;
}

.phone-btn {
  background: linear-gradient(135deg, #2196f3 0%, #1976d2 100%);
  color: #fff;
  box-shadow: 0 6rpx 20rpx rgba(33, 150, 243, 0.3);
}

.phone-btn::after {
  border: none;
}

.phone-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(33, 150, 243, 0.2);
}