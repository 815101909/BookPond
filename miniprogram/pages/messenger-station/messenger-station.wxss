/* 信使驿站页面样式 */
.container {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100vh;
  background-color: #e8f5e9; /* 浅绿色背景 */
  padding: 30rpx;
  box-sizing: border-box;
}

.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
  padding-bottom: 20rpx;
  border-bottom: 1px solid #e0e0e0;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #888;
}

.message-list {
  flex: 1;
  overflow-y: auto;
  width: 100%;
}

.message-item {
  background-color: #fff;
  border-radius: 16rpx;
  margin-bottom: 30rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.message-content {
  display: flex;
  margin-bottom: 20rpx;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background-color: #eee;
}

.message-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.message-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 10rpx;
}

.username {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
}

.time {
  font-size: 24rpx;
  color: #999;
}

.message-content-text {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1.4;
}

.message-footer {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #999;
}

.message-type-container {
  display: flex;
  align-items: center;
}

.message-type {
  color: #4caf50;
  background-color: rgba(76, 175, 80, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-right: 10rpx;
}

.writing-date {
  color: #424242;
  font-size: 22rpx;
  font-weight: bold;
  border-left: 2px solid #e0e0e0;
  padding-left: 10rpx;
  margin-left: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 180rpx;
}

.unread-badge {
  background-color: #f44336;
  color: #fff;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 20rpx;
  min-width: 20rpx;
  text-align: center;
}

.message-actions {
  display: flex;
  justify-content: space-around;
  padding-top: 20rpx;
  border-top: 1px solid #f0f0f0;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 20rpx;
}

.action-icon {
  font-size: 36rpx;
  margin-bottom: 6rpx;
}

.action-text {
  font-size: 24rpx;
  color: #666;
}

.read .action-text {
  color: #4caf50;
}

.share .action-text {
  color: #2196f3;
}

.delete .action-text {
  color: #f44336;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.empty-tip {
  font-size: 26rpx;
  color: #bbb;
}

.bottom-actions {
  display: flex;
  justify-content: space-around;
  padding: 30rpx 0;
  border-top: 1px solid #e0e0e0;
}

.bottom-actions .action-btn {
  flex: 1;
  flex-direction: row;
  justify-content: center;
  background-color: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin: 0 10rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.bottom-actions .action-icon {
  margin-right: 10rpx;
  margin-bottom: 0;
}

.bottom-actions .action-text {
  font-size: 28rpx;
}

.back {
  background-color: #f5f5f5;
}

.new-message {
  background-color: #e0f7fa;
  color: #999;
} 