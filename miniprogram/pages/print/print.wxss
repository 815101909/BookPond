/* 打印页面样式 */
.container {
  min-height: 100vh;
  background: #F8FFF8; /* 最浅的绿色背景 */
  padding: 20rpx;
  box-sizing: border-box;
}

/* 语言选择栏 */
.language-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: rgba(255, 255, 255, 0.95);
  padding: 20rpx 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.language-picker {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 15rpx 30rpx;
  background: #F8FFF8;
  border-radius: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.language-text {
  font-size: 28rpx;
  color: #333;
  margin-right: 10rpx;
}

.picker-arrow {
  font-size: 20rpx;
  color: #666;
}

/* 主要内容区域 */
.main-content {
  margin-top: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 40rpx;
}

/* A4预览区域 */
.preview-container {
  display: flex;
  justify-content: center;
  padding: 10rpx 0;
  width: 100%;
}

/* A4页面 */
.a4-page {
  width: 750rpx; /* 增加宽度 */
  min-height: 1060rpx; /* 按A4比例增加高度 */
  background: #FFFFFF;
  box-sizing: border-box;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  border-radius: 8rpx;
  overflow: hidden;
}

/* 打印图片 */
.print-image {
  width: 100%;
  height: 100%;
  display: block;
}

/* 底部文字区域 */
.footer {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 40rpx 0;
}

.footer-text {
  font-family: "STKaiti", "楷体", serif;
}

.footer-text.main {
  font-size: 40rpx;
  color: #666;
  font-weight: 500;
  letter-spacing: 8rpx;
  opacity: 0;
  transform: translateY(20rpx);
  animation: fadeInUp 0.8s ease forwards;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 分隔装饰 */
.footer-divider {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 8rpx 0;
}

.footer-divider .dot {
  width: 8rpx;
  height: 8rpx;
  background: #FF77A8;
  border-radius: 50%;
}

.footer-divider .line {
  width: 60rpx;
  height: 2rpx;
  background: linear-gradient(90deg, #FF77A8, #FFB6C1);
}

/* 打印内容样式 */
.print-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
  line-height: 1.4;
  text-align: center;
}

.print-title-translation {
  font-size: 34rpx;
  color: #666;
  margin-bottom: 40rpx;
  line-height: 1.4;
  text-align: center;
}

.print-body {
  margin-top: 40rpx;
}

.print-paragraph {
  font-size: 30rpx;
  color: #333;
  line-height: 1.8;
  margin-bottom: 30rpx;
  text-align: justify;
  text-indent: 2em;
} 