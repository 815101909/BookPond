/* 录音仓库页面样式 */
.container {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100vh;
  background-color: #e8f5e9; /* 浅绿色背景 */
  padding: 30rpx;
  box-sizing: border-box;
}

.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
  padding-bottom: 20rpx;
  border-bottom: 1px solid #e0e0e0;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #888;
}

.recording-list {
  flex: 1;
  overflow-y: auto;
  width: 100%;
}

.recording-item {
  position: relative;
  background-color: #fff9fa; /* 最浅的淡粉色背景 */
  border-radius: 16rpx;
  margin-bottom: 30rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

/* 标题覆盖层样式 */
.recording-title-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  background: linear-gradient(to bottom, rgba(255,182,193,0.8) 0%, rgba(255,192,203,0.5) 70%, rgba(255,192,203,0) 100%); /* 粉色渐变背景 */
  padding: 20rpx;
  border-top-left-radius: 16rpx;
  border-top-right-radius: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  z-index: 1;
}

.recording-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #555; /* 深色文字，更易读 */
  text-shadow: 0 1px 2px rgba(255,255,255,0.5); /* 白色阴影提高可读性 */
  flex: 1;
}

.recording-type {
  font-size: 24rpx;
  color: #555;
  background-color: rgba(255,192,203,0.5); /* 半透明粉色背景 */
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-left: 10rpx;
}

.recording-content {
  display: flex;
  margin-top: 60rpx; /* 为标题覆盖层留出空间 */
  margin-bottom: 20rpx;
}

.recording-cover {
  width: 180rpx;
  height: 180rpx; /* 调整高度与文本框完全匹配 */
  border-radius: 12rpx;
  margin-right: 20rpx;
  background-color: #eee;
  object-fit: cover;
}

.recording-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

/* 移除原有的标题头部样式 */
.recording-header {
  display: none;
}

/* 新的字幕容器样式 */
.recording-subtitle-container {
  height: 180rpx;
  margin-bottom: 16rpx;
  background-color: #fef5f7; /* 淡粉色背景，比条目背景稍深 */
  border-radius: 8rpx;
  border: 1px solid #ffe0e5; /* 粉色边框 */
}

.recording-subtitle-scroll {
  height: 100%;
  padding: 10rpx;
}

.recording-subtitle {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  text-align: justify;
  display: block;
  white-space: normal;
  word-break: break-all;
}

.recording-meta {
  display: flex;
  flex-direction: column;
  font-size: 24rpx;
  color: #999;
}

/* 元数据行样式 */
.meta-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.meta-group {
  display: flex;
  align-items: center;
  margin-right: 20rpx;
}

.meta-label {
  color: #999;
  margin-right: 8rpx;
}

.recording-difficulty,
.recording-date {
  color: #666;
  font-weight: 500;
}

.recording-actions {
  display: flex;
  justify-content: space-around;
  padding-top: 20rpx;
  border-top: 1px solid #ffe0e5; /* 粉色分隔线 */
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 20rpx;
}

.action-icon {
  font-size: 36rpx;
  margin-bottom: 6rpx;
}

.action-text {
  font-size: 24rpx;
  color: #666;
}

.play .action-text {
  color: #ff8ea6; /* 粉色播放按钮 */
}

.share .action-text {
  color: #80b3ff; /* 蓝色分享按钮 */
}

.delete .action-text {
  color: #ff7f7f; /* 红粉色删除按钮 */
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.empty-tip {
  font-size: 26rpx;
  color: #bbb;
}

.bottom-actions {
  display: flex;
  justify-content: space-around;
  padding: 30rpx 0;
  border-top: 1px solid #e0e0e0;
}

.bottom-actions .action-btn {
  flex: 1;
  flex-direction: row;
  justify-content: center;
  background-color: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin: 0 10rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.bottom-actions .action-icon {
  margin-right: 10rpx;
  margin-bottom: 0;
}

.bottom-actions .action-text {
  font-size: 28rpx;
}

.back {
  background-color: #f5f5f5;
}

.record {
  background-color: #ffeff3; /* 粉色"开始录音"按钮 */
} 