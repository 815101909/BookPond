/* 说一说页面样式 */
page {
  background: #E8F5E9;
}

.container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: #E8F5E9;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  box-sizing: border-box; /* 确保padding包含在宽度内 */
  overflow: hidden; /* 防止整体溢出 */
}

/* 欢迎语部分 */
.welcome-section {
  text-align: center;
  margin-bottom: 30rpx;
}

.welcome-title {
  display: block;
  font-size: 48rpx;
  color: #1B5E20;
  font-weight: bold;
  margin-bottom: 16rpx;
  letter-spacing: 2rpx;
}

.welcome-subtitle {
  display: block;
  font-size: 28rpx;
  color: #388E3C;
  letter-spacing: 1rpx;
}

/* 花园模式顶部导航栏 */
.garden-navbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #FFFEF0;
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  flex-wrap: wrap;
  gap: 12rpx;
}

/* 花园模式标签 */
.garden-mode {
  display: flex;
  align-items: center;
  background: #FF87B5; /* 粉色背景 */
  padding: 10rpx 16rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(255, 135, 181, 0.3);
  margin-right: 16rpx;
  flex-shrink: 0;
}

.mode-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.mode-text {
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: bold;
  letter-spacing: 1rpx;
}

.flowers-display {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
  justify-content: flex-end;
  flex-wrap: wrap;
}

.flowers-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.flowers-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.flowers-info::after {
  content: '';
  position: absolute;
  right: -10rpx;
  height: 80%;
  width: 1rpx;
  background-color: #eee;
}

.flowers-info:last-of-type::after {
  display: none;
}

.flowers-label {
  font-size: 24rpx;
  color: #666666;
}

.flowers-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #FF87B5; /* 粉色数值 */
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.1);
}

/* 即将获得花朵奖励的动画效果 */
@keyframes pulse-reward {
  0% { transform: scale(1); }
  50% { transform: scale(1.1); }
  100% { transform: scale(1); }
}

.flowers-info:first-child .flowers-value {
  position: relative;
}

.flowers-info:first-child .flowers-value[data-almost="true"]::after {
  content: '✨';
  position: absolute;
  top: -8rpx;
  right: -24rpx;
  font-size: 24rpx;
  animation: pulse-reward 1.5s infinite;
}

/* 查看规则按钮 */
.view-rules {
  display: flex;
  align-items: center;
  background: #FFF0F5; /* 浅粉色背景 */
  padding: 6rpx 12rpx;
  border-radius: 20rpx;
  border: 1rpx solid #FF87B5;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.1);
  cursor: pointer;
  transition: all 0.2s ease;
  margin-left: 10rpx;
}

.view-rules:active {
  background: #FFD6E7;
  transform: scale(0.95);
}

.rules-text {
  font-size: 24rpx;
  color: #FF5B9E;
  font-weight: 500;
}

/* 花园规则弹窗 */
.garden-rules-popup {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}

.rules-content {
  width: 80%;
  background-color: #FFFEF0;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.rules-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background-color: #FF87B5; /* 粉色标题栏 */
  color: white;
}

.rules-title {
  font-size: 32rpx;
  font-weight: bold;
}

.close-button {
  font-size: 40rpx;
  line-height: 1;
  padding: 0 10rpx;
}

.rules-body {
  padding: 24rpx;
}

.rule-item {
  margin-bottom: 24rpx;
}

.rule-title {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}

/* 花园状态样式 */
.garden-status {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed #E0E0E0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 录音计数器样式 */
.counter-display {
  background-color: #FFF0F5;
  padding: 16rpx;
  border-radius: 10rpx;
  margin: 16rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.counter-text {
  font-size: 26rpx;
  color: #555;
  margin-bottom: 8rpx;
  text-align: center;
}

.counter-value {
  font-size: 28rpx;
  font-weight: bold;
  color: #FF87B5;
}

.garden-text {
  font-size: 28rpx;
  color: #333;
  text-align: center;
  margin-bottom: 12rpx;
}

.flowers-needed {
  color: #FF5B9E;
  font-weight: bold;
}

/* 其他样式 */
.content-section {
  width: 100%;
  flex: 1;
  overflow-y: auto;
}

/* 书签式抽拉按钮和设置部分 */
.bookmark-settings-section {
  width: 100%;
  margin-bottom: 24rpx;
}

.bookmark-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  position: relative;
  height: 80rpx;
}

/* 书签标签样式 */
.bookmark-tab {
  display: flex;
  align-items: center;
  background: #FFD6E7;
  border-radius: 12rpx 0 0 12rpx;
  padding: 12rpx 30rpx 12rpx 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  z-index: 5;
  transition: all 0.3s ease;
  position: absolute;
  left: 0;
  height: 100%;
  box-sizing: border-box;
  width: 220rpx; /* 从200rpx增加到220rpx，扩展宽度 */
}

.bookmark-tab.expanded {
  left: 220rpx; /* 从200rpx增加到220rpx，与上面保持一致 */
  background: #FF87B5;
}

.bookmark-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.bookmark-text {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  transition: color 0.3s ease;
}

.bookmark-tab.expanded .bookmark-text {
  color: white;
}

/* 设置项样式 */
.settings-item {
  display: flex;
  align-items: center;
  background: #FFFEF0;
  border-radius: 0 12rpx 12rpx 0;
  padding: 12rpx 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  position: absolute;
  left: 220rpx; /* 从200rpx增加到220rpx，与上面保持一致 */
  right: 0;
  height: 100%;
  box-sizing: border-box;
  transition: left 0.3s ease;
  white-space: nowrap; /* 防止标签文本换行 */
  overflow: hidden; /* 确保不会溢出 */
}

.settings-item.shifted {
  left: 420rpx; /* 从380rpx增加到420rpx，匹配书签标签宽度增加 */
}

.settings-label {
  font-size: 26rpx;
  color: #333;
  margin-right: 16rpx;
  min-width: 190rpx; /* 增加最小宽度以适应更长的标签文本 */
  flex-shrink: 0;
}

.settings-value {
  flex: 1;
  background: #FFF;
  border: 1rpx solid #E0E0E0;
  border-radius: 8rpx;
}

.selector-common {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 16rpx;
  width: 100%;
  box-sizing: border-box;
}

.selector-text {
  font-size: 26rpx;
  color: #333;
  text-align: center;
  width: 100%;
}

/* 内容区域样式 */
.section-title {
  margin-bottom: 18rpx;
  display: flex;
  flex-direction: row;
  align-items: baseline;
  padding: 8rpx 0;
  position: relative;
}

.section-title::after {
  content: '';
  position: absolute;
  left: 0;
  bottom: 0;
  height: 3rpx;
  width: 80rpx;
  background: linear-gradient(to right, #FF5B9E, transparent);
  border-radius: 3rpx;
}

.title-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #FF5B9E;
}

/* 主标题和副标题样式 */
.title-main {
  font-size: 38rpx;
  font-weight: bold;
  color: #FF5B9E;
  margin-right: 16rpx;
  text-shadow: 0 1rpx 2rpx rgba(255, 91, 158, 0.2);
  letter-spacing: 1rpx;
}

.title-sub {
  font-size: 26rpx;
  color: #888;
  position: relative;
  top: 2rpx;
  background: linear-gradient(to right, #888, #aaa);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  font-weight: 500;
}

.section-desc {
  font-size: 24rpx;
  color: #666;
  display: block;
  margin-bottom: 24rpx;
}

.hotspot-content, .classic-content {
  background: linear-gradient(to bottom, #FFFEF0, #FFF8F8);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  border: 1rpx solid rgba(255, 91, 158, 0.1);
  transition: all 0.3s ease;
  position: relative; /* 添加相对定位以支持内部菜单的绝对定位 */
}

.hotspot-content:hover, .classic-content:hover {
  transform: translateY(-2rpx);
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.12);
}

.no-selection {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 120rpx;
  background: #FFFEF0;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  margin-bottom: 24rpx;
}

.prompt-text {
  font-size: 30rpx;
  color: #999;
}

/* 添加内容区域样式 */
.content-settings {
  display: flex;
  flex-direction: column;
  margin: 16rpx 0 24rpx;
  padding: 20rpx;
  background-color: #FFFEF0; /* 最浅的黄色背景 */
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(255, 212, 128, 0.2); /* 添加浅黄色边框 */
}

.date-picker-container, .difficulty-selector {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.settings-mini-label {
  font-size: 26rpx;
  color: #666;
  margin-right: 16rpx;
  min-width: 110rpx;
}

.date-picker-value {
  font-size: 26rpx;
  padding: 6rpx 16rpx;
  background-color: #fff;
  border-radius: 8rpx;
  border: 1rpx solid #ddd;
  min-width: 170rpx;
  text-align: center;
}

.difficulty-selector {
  display: flex;
  align-items: center;
  width: 100%;
}

.difficulty-btns {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  width: 100%;
  justify-content: center;
}

.difficulty-btn {
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
  border-radius: 10rpx;
  background-color: #fff;
  border: 1rpx solid #FFE082;
  transition: all 0.3s;
  box-shadow: 0 2rpx 6rpx rgba(255, 193, 7, 0.1);
}

.difficulty-btn.active {
  background: linear-gradient(135deg, #FFD6E7, #FF87B5);
  border-color: #FF87B5;
  color: white;
  box-shadow: 0 4rpx 8rpx rgba(255, 91, 158, 0.25);
  transform: translateY(-2rpx);
}

.difficulty-btn:active {
  transform: scale(0.96);
}

.difficulty-icon {
  margin-right: 8rpx;
  font-size: 26rpx;
}

.difficulty-name {
  font-size: 26rpx;
  font-weight: 500;
}

.difficulty-btn.active .difficulty-name {
  color: white;
}

/* 电影屏幕样式 */
.video-screen {
  width: 100%;
  height: 405rpx;
  background: #000;
  border-radius: 20rpx;
  overflow: hidden;
  position: relative;
  margin-top: 35rpx;  /* 从15rpx增加到35rpx */
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.screen-header {
  display: flex;
  flex-direction: column;
  padding: 10rpx 14rpx;
  background-color: #333;
}

.xiaoshi-logo {
  width: 50rpx;
  height: 50rpx;
  margin-right: 14rpx;
}

.video-title {
  color: #fff;
  font-size: 24rpx;
  font-weight: 500;
  text-align: center;
  padding: 4rpx 0;
}

.video-title-translation {
  color: rgba(255, 91, 91, 0.9);
  font-size: 22rpx;
  text-align: center;
  padding: 2rpx 0;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.2);
  font-weight: 400;
}

.screen-content {
  position: relative;
  width: 100%;
  height: 330rpx;
  background-color: #000;
}

.content-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.play-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
}

/* 为play-icon添加更具体的选择器，防止全局样式冲突 */
.play-overlay .play-icon {
  display: inline-block;
  width: 60rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 50%;
  position: relative;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.2);
}

/* 使用更具体的选择器定义三角形 */
.play-overlay .play-icon::before {
  content: "";
  position: absolute;
  top: 50%;
  left: 55%;
  transform: translate(-50%, -50%);
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 15rpx 0 15rpx 25rpx;
  border-color: transparent transparent transparent #FF6B81;
}

.subtitle-bar {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx;
  background-color: rgba(0, 0, 0, 0.6);
  min-height: 90rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.subtitle-text {
  color: #fff;
  font-size: 24rpx;
  text-align: center;
  line-height: 1.4;
  margin-bottom: 6rpx;
}

.subtitle-translation {
  color: rgba(255, 91, 91, 0.9);
  font-size: 22rpx;
  text-align: center;
  line-height: 1.4;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.2);
  font-weight: 400;
}

/* 控制区域样式 */
.control-area {
  display: flex;
  flex-direction: row;
  justify-content: space-evenly;
  align-items: center;
  margin: 16rpx 0;
  padding: 16rpx;
  background-color: #FFFEF0;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  margin-top: 30rpx;  /* 从10rpx增加到30rpx */
}

/* 统一的按钮样式，确保完全相同的尺寸 */
.record-control,
.playback-control,
.save-button {
  width: 120rpx !important;
  height: 90rpx !important; /* 从100rpx减小到90rpx，使整体更紧凑 */
  min-width: 120rpx !important;
  min-height: 90rpx !important; /* 从100rpx减小到90rpx */
  max-width: 120rpx !important;
  max-height: 90rpx !important; /* 从100rpx减小到90rpx */
  
  display: flex !important;
  flex-direction: column !important;
  align-items: center !important;
  justify-content: center !important;
  
  border-radius: 12rpx !important;
  background-color: #FFD6E7 !important;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1) !important;
  
  padding: 8rpx 5rpx !important; /* 调整内边距，上下增加，左右保持 */
  margin: 0 !important;
  box-sizing: border-box !important;
  overflow: hidden !important;
  
  position: static !important;
  flex: none !important;
  text-align: center !important;
}

/* 只在录音时改变背景色 */
.record-control.recording {
  background-color: #FF87B5 !important;
  animation: pulse 1.5s infinite;
}

/* 禁用状态 */
.disabled {
  opacity: 0.7 !important;
  pointer-events: none !important;
  background-color: #FFEAF3 !important;
  box-shadow: none !important;
}

/* 控制图标和文字样式 */
.control-icon {
  font-size: 24rpx !important;  /* 从22rpx增加到24rpx */
  line-height: 1 !important;
  position: relative;
  display: block !important;
  text-align: center !important;
  margin: 0 auto 6rpx !important;
  background: transparent !important;
  border: none !important;
  width: auto !important;
  height: auto !important;
  padding: 4rpx 0 !important;
}

/* 确保播放控制按钮中的图标不会显示一个不需要的三角形 */
.control-icon::before,
.control-icon::after {
  content: none !important;
  display: none !important;
  border: none !important;
  background: transparent !important;
}

/* 播放和暂停图标使用文本符号 */
.playback-control .control-icon {
  font-size: 18rpx !important; /* 从20rpx减小到18rpx */
  line-height: 1 !important;
}

.control-text {
  font-size: 20rpx !important;  /* 从18rpx增加到20rpx */
  line-height: 1 !important;
  color: #666 !important;
  text-align: center !important;
  width: 100% !important;
  white-space: nowrap !important;
  overflow: hidden !important;
  text-overflow: ellipsis !important;
  margin-top: 2rpx !important;
}

/* 移除所有箭头和装饰 */
.save-button:after,
.playback-control:after {
  content: none !important;
  display: none !important;
}

/* 保存区域样式 */
.save-area {
  margin: 16rpx 0;
  padding: 12rpx;
  background-color: #f8f8f8;
  border-radius: 12rpx;
}

.recording-playback {
  display: flex;
  justify-content: space-between;
}

.playback-control, .save-button {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 20rpx;
  border-radius: 8rpx;
  min-width: 40%;
}

.playback-control {
  background-color: #f0f0f0;
  color: #666;
}

.save-button {
  background-color: #52c41a;
  color: #fff;
  position: relative;
  padding-right: 32rpx;
  transition: transform 0.3s;
}

.save-button:after {
  content: "→";
  position: absolute;
  right: 12rpx;
  font-size: 24rpx;
  opacity: 0.8;
}

.save-button:active {
  transform: translateX(5rpx);
}

/* 语言选择菜单样式 */
.language-menu {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #fff;
  border-top-left-radius: 20rpx;
  border-top-right-radius: 20rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.1);
  z-index: 200;
  animation: slideUp 0.3s ease;
  max-height: 80vh;
  overflow-y: auto;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.language-menu-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.language-menu-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.language-menu-close {
  font-size: 36rpx;
  color: #999;
  padding: 0 10rpx;
}

.language-menu-body {
  padding: 20rpx;
}

.language-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.language-option {
  padding: 16rpx 24rpx;
  background-color: #f5f5f5;
  border-radius: 10rpx;
  transition: all 0.3s;
  min-width: 140rpx;
  text-align: center;
}

.language-option.active {
  background: linear-gradient(135deg, #FFD6E7, #FF87B5);
  color: white;
  box-shadow: 0 4rpx 8rpx rgba(255, 91, 158, 0.25);
}

.language-name {
  font-size: 26rpx;
  font-weight: 500;
}

.language-option.active .language-name {
  color: white;
}

/* 花园墙花朵动画 */
@keyframes gentle-sway {
  0% { transform: rotate(0deg); }
  25% { transform: rotate(2deg); }
  50% { transform: rotate(0deg); }
  75% { transform: rotate(-2deg); }
  100% { transform: rotate(0deg); }
}

@keyframes fade-in {
  from { opacity: 0; transform: translateY(10rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes bloom {
  0% { transform: scale(0.8); opacity: 0.6; }
  50% { transform: scale(1.05); opacity: 1; }
  100% { transform: scale(1); opacity: 1; }
}

@keyframes gentle-glow {
  0% { box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05); }
  50% { box-shadow: 0 4rpx 15rpx rgba(255, 135, 181, 0.25); }
  100% { box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05); }
}

.garden-wall {
  background: linear-gradient(to bottom, #FFFEF0, #FFF8F8);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-top: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  border: 1rpx solid rgba(255, 91, 158, 0.1);
  position: relative;
  overflow: hidden;
  animation: fade-in 0.8s ease-out;
}

.garden-wall::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(to right, #FF87B5, #FFD6E7);
  border-radius: 6rpx 6rpx 0 0;
}

.garden-wall-header {
  text-align: center;
  margin-bottom: 30rpx;
  position: relative;
}

.garden-wall-header::after {
  content: '';
  position: absolute;
  bottom: -10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 2rpx;
  background: rgba(255, 135, 181, 0.5);
}

.garden-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #FF5B9E;
  display: block;
  margin-bottom: 8rpx;
  text-shadow: 0 1rpx 3rpx rgba(255, 91, 158, 0.15);
  letter-spacing: 2rpx;
}

.garden-subtitle {
  font-size: 24rpx;
  color: #888;
  display: block;
  letter-spacing: 1rpx;
}

/* 空花园样式 */
.empty-garden {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0;
  opacity: 0.8;
  animation: fade-in 1s ease-out;
}

.empty-garden-image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 20rpx;
  animation: gentle-sway 5s infinite ease-in-out;
}

.empty-garden-text {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.empty-garden-tip {
  font-size: 24rpx;
  color: #999;
  font-style: italic;
}

/* 空花园备选显示样式 */
.empty-garden-fallback {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 20rpx;
  animation: gentle-sway 5s infinite ease-in-out;
}

.fallback-icon {
  font-size: 120rpx;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  animation: bloom 3s infinite alternate ease-in-out;
}

/* 花朵墙样式 - 轮播版 */
.flowers-wall {
  padding: 20rpx 0 40rpx 0; /* 增加底部空间放置指示点 */
}

.flowers-swiper {
  width: 100%;
  height: 350rpx; /* 增加高度适应新花朵标记 */
  padding: 10rpx 0;
}

/* 轮播中的花朵项样式 */
.flowers-swiper .flower-item {
  width: 90%;
  height: 280rpx;
  margin: 0 auto;
  background-color: rgba(255, 255, 255, 0.9);
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.1);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  transition: all 0.3s ease;
  transform: scale(0.95);
  animation: gentle-glow 3s infinite ease-in-out;
}

.flowers-swiper .flower-icon {
  font-size: 100rpx; /* 更大的花朵图标 */
  margin-bottom: 20rpx;
  animation: gentle-sway 5s infinite ease-in-out;
}

.flowers-swiper .flower-details {
  text-align: center;
  width: 100%;
  padding: 0 10rpx;
}

.flowers-swiper .flower-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.flowers-swiper .flower-meaning {
  font-size: 24rpx;
  color: #666;
  display: block;
  line-height: 1.5;
  max-height: 100rpx;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}

/* 轮播指示点自定义样式 */
.flowers-swiper .wx-swiper-dots {
  margin-bottom: -10rpx;
}

.flowers-swiper .wx-swiper-dot {
  width: 16rpx;
  height: 16rpx;
  background: rgba(255, 135, 181, 0.3);
}

.flowers-swiper .wx-swiper-dot-active {
  background: rgba(255, 91, 158, 0.8);
}

/* 花朵轮播光效 */
.flowers-swiper .flower-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: -150%;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    to right,
    rgba(255, 255, 255, 0) 0%,
    rgba(255, 255, 255, 0.3) 50%,
    rgba(255, 255, 255, 0) 100%
  );
  transform: skewX(-25deg);
  animation: shine 6s infinite;
}

@keyframes shine {
  0% { left: -150%; }
  40% { left: 150%; }
  100% { left: 150%; }
}

/* 花园底部装饰 */
.garden-wall::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 10rpx;
  background: linear-gradient(to right, transparent, rgba(255, 191, 215, 0.3), transparent);
  z-index: 1;
}

/* 花园壁纸图案 */
.garden-wall-pattern {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  opacity: 0.05;
  background-image: radial-gradient(rgba(255, 135, 181, 0.2) 1px, transparent 1px);
  background-size: 20rpx 20rpx;
  pointer-events: none;
  z-index: 0;
}

/* 新花朵特效动画 */
@keyframes pop-in {
  0% { transform: scale(0.5); opacity: 0; }
  70% { transform: scale(1.1); opacity: 1; }
  85% { transform: scale(0.95); opacity: 1; }
  100% { transform: scale(1); opacity: 1; }
}

@keyframes sparkle {
  0%, 100% { filter: drop-shadow(0 0 3rpx rgba(255, 255, 255, 0.8)); }
  50% { filter: drop-shadow(0 0 10rpx rgba(255, 255, 255, 0.9)); }
}

.flowers-swiper .flower-item.new-flower {
  animation: pop-in 0.8s ease-out, gentle-glow 3s infinite ease-in-out;
  border: 2rpx solid rgba(255, 215, 0, 0.5);
  box-shadow: 0 8rpx 20rpx rgba(255, 215, 0, 0.2);
  background: linear-gradient(to bottom, rgba(255, 255, 255, 0.95), rgba(255, 250, 230, 0.9));
}

.flowers-swiper .flower-item.new-flower::after {
  content: '✨';
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  font-size: 28rpx;
  animation: sparkle 2s infinite;
}

.flowers-swiper .flower-item.new-flower .flower-icon {
  animation: gentle-sway 4s infinite ease-in-out, sparkle 2s infinite;
}

/* 按钮激活状态 */
.playback-control.active,
.save-button.active,
.playback-control:active,
.save-button:active {
  background-color: #FF87B5 !important;
  transform: scale(0.95);
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.1);
}
