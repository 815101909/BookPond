      { id: 1, text: '人工智能时代', showTranslation: false },
      { id: 2, text: '科技与生活', showTranslation: false }
    ]
  };
}

/**
 * 测试API连接
 * @returns {Promise} - 返回测试结果的 Promise
 */
function testConnection() {
  return new Promise(async (resolve) => {
    try {
      // 检查网络连接
      const isConnected = await checkNetworkStatus();
      if (!isConnected) {
        resolve({
          success: false,
          message: '设备未连接到网络',
          details: '请检查您的网络连接'
        });
        return;
      }
      
      // 如果强制使用模拟数据，直接返回提示
      if (DEV_CONFIG.USE_MOCK_DATA) {
        resolve({
          success: true,
          message: '开发模式 - 使用模拟数据',
          details: '系统当前配置为使用模拟数据，未进行实际API测试'
        });
        return;
      }
      
      // 尝试发送请求到后端
      const testUrl = '/api/test';
      
      // 设置超时
      const timeout = setTimeout(() => {
        resolve({
          success: false,
          message: '请求超时',
          details: `${BASE_URL}${testUrl} 连接超时，请检查 BASE_URL 是否正确`
        });
      }, 5000);
      
      try {
        await request(testUrl);
        clearTimeout(timeout);
        resolve({
          success: true,
          message: 'API连接成功',
          details: `成功连接到 ${BASE_URL}`
        });
      } catch (error) {
        clearTimeout(timeout);
        resolve({
          success: false,
          message: '无法连接到API',
          details: error.message || '连接失败，请检查 BASE_URL 是否正确'
        });
      }
    } catch (error) {
      resolve({
        success: false,
        message: '测试期间发生错误',
        details: error.message || '未知错误'
      });
    }
  });
}

// 导出函数
module.exports = {
  getNewsList,
  getClassicsList,
  getCardData,
  getMockNewsData,
  getMockClassicsData,
  getMockCardData,
  checkNetworkStatus,
  DEV_CONFIG,
  testConnection,
  BASE_URL
}; 