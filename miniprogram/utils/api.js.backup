 * @param {string} articleId - 文章ID
 * @param {string} type - 文章类型 (news, classics)
 * @returns {Object} - 模拟学习卡片数据
 */
function getMockCardData(articleId, type) {
  // 返回模拟的学习卡片数据
  const isClassic = articleId.includes('classic');
  
  return {
    words: [
      { id: 1, text: '科技', showTranslation: false },
